   * SEO title default situs.
   * Digunakan sebagai fallback metadata halaman
   * ketika halaman tidak memiliki SEO khusus.
   */
  seoTitle String?

  /**
   * Meta description default situs.
   */
  seoDescription String?

  /**
   * Keywords global situs.
   * Contoh:
   * ikan segar, seafood, ikan frozen, udang, cumi
   */
  seoKeywords String?

  /**
   * Canonical URL utama situs.
   * Contoh:
   * https://app.pusatikansegar.com
   */
  seoCanonicalUrl String?

  /**
   * Default Open Graph title.
   */
  seoOgTitle String?

  /**
   * Default Open Graph description.
   */
  seoOgDescription String?

  /**
   * URL/path gambar Open Graph default.
   */
  seoOgImage String?

  /**
   * Twitter/X card type.
   * Default:
   * summary_large_image
   */
  seoTwitterCard String @default("summary_large_image")

  /**
   * Mengizinkan halaman publik di-index
   * oleh mesin pencari.
   */
  seoRobotsIndex Boolean @default(true)

  /**
   * Mengizinkan crawler mengikuti link
   * pada halaman publik.
   */
  seoRobotsFollow Boolean @default(true)

  /**
   * Google Search Console verification token.
   */
  seoGoogleVerification String?

  /**
   * Feature flag untuk Smart SEO AI.
   * true = fitur Smart SEO tersedia.
   * Flag ini TIDAK berarti AI boleh mengubah
   * metadata secara otomatis.
   */
  seoAiEnabled Boolean @default(true)

  // ----------------------------------------------------------
  // TIMESTAMP
  // ----------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// SOCIAL & STORE LINKS
// ============================================================
//
// Konfigurasi link eksternal storefront.
//
// Berbeda dari StoreSettings karena:
// - StoreSettings = identitas dan operasional toko
// - SocialStoreLinks = kanal distribusi / social presence
//
// Digunakan oleh:
// - Footer storefront
// - CTA Google Play
// - Marketplace links
// - Social media links
//
// ============================================================

model SocialStoreLinks {
  id String @id @default(uuid())

  /**
   * ==========================================================
   * APPLICATION / GOOGLE PLAY
   * ==========================================================
   */

  googlePlayUrl String?

  /**
   * ==========================================================
   * MARKETPLACE
   * ==========================================================
   */

  shopeeUrl    String?
  tokopediaUrl String?

  /**
   * ==========================================================
   * SOCIAL MEDIA
   * ==========================================================
   */

  tiktokUrl    String?
  instagramUrl String?

  /**
   * ==========================================================
   * TIMESTAMPS
   * ==========================================================
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_store_links")
}

// ============================================================
// LANDING PAGE SETTINGS
// ============================================================
//
// Konfigurasi khusus marketing landing page:
// https://pusatikansegar.com
//
// Berbeda dengan StoreSettings yang digunakan storefront:
// https://app.pusatikansegar.com
//
// ============================================================

model LandingPageSettings {
  id      String  @id @default(uuid())
  key     String  @unique @default("default")
  enabled Boolean @default(true)

  /**
   * Seluruh konten landing page.
   * Struktur JSON divalidasi oleh Landing Page Service,
   * bukan diserahkan langsung ke Prisma.
   */
  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seoAnalyses LandingPageSeoAnalysis[]
}

// ============================================================
// LANDING PAGE SEO ANALYSIS
// ============================================================
//
// Menyimpan histori hasil audit SEO landing page.
//
// Score dihitung deterministic oleh application,
// sedangkan AI hanya memberikan rekomendasi.
//
// ============================================================

model LandingPageSeoAnalysis {
  id                    String @id @default(uuid())
  landingPageSettingsId String

  /**
   * SEO score 0 - 100.
   */
  score Int

  /**
   * Detail hasil pemeriksaan SEO.
   */
  analysis Json

  /**
   * Rekomendasi perbaikan.
   */
  recommendations Json

  /**
   * Sumber analisis.
   * RULE_ENGINE = deterministic analyzer
   * AI          = AI recommendation/analyzer
   */
  source String @default("RULE_ENGINE")

  createdAt DateTime @default(now())

  landingPageSettings LandingPageSettings @relation(fields: [landingPageSettingsId], references: [id], onDelete: Cascade)

  @@index([landingPageSettingsId, createdAt])
}

// ============================================================
// LANDING PAGE ANDROID APP
// ============================================================
//
// Metadata APK Android.
//
// Binary APK TIDAK disimpan di database.
// Database hanya menyimpan metadata dan lokasi file.
//
// ============================================================

model LandingPageAndroidApp {
  id      String  @id @default(uuid())
  key     String  @unique @default("default")
  enabled Boolean @default(false)

  appName     String
  version     String
  description String?

  /**
   * Metadata file APK.
   */
  fileName String?
  fileUrl  String?
  mimeType String?
  fileSize Int?

  /**
   * SHA-256 untuk verifikasi integritas APK.
   */
  sha256 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// LANDING PAGE IOS APP
// ============================================================
//
// Metadata aplikasi iOS.
// Binary IPA TIDAK disimpan di database.
// Database hanya menyimpan metadata dan URL App Store.
//
// ============================================================

model LandingPageIosApp {
  id      String  @id @default(uuid())
  key     String  @unique @default("default")
  enabled Boolean @default(false)

  appName     String
  version     String
  description String?

  appStoreUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// CHANGELOG
// ============================================================

model ChangelogRelease {
  id String @id @default(cuid())

  version     String
  date        DateTime
  title       String
  description String?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  entries ChangelogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, date])
  @@index([sortOrder])
}

model ChangelogEntry {
  id String @id @default(cuid())

  releaseId String
  release   ChangelogRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  type        ChangelogType
  title       String
  description String
  highlights  Json?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([releaseId, sortOrder])
}

enum ChangelogType {
  FEATURE
  IMPROVEMENT
  FIX
  PERFORMANCE
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType
  href    String?

  // Idempotency key untuk mencegah notifikasi duplikat
  eventKey String? @unique

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([orderId])
}

model PushSubscription {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @db.Text

  p256dh String @db.Text

  auth String @db.Text

  userAgent String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
}

model Promotion {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  banner String?

  status PromotionStatus @default(DRAFT)

  startAt DateTime?
  endAt   DateTime?

  type PromotionType @default(MARKETING)

  discountType  PromotionDiscountType?
  discountValue Decimal?               @db.Decimal(12, 2)

  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)

  items PromotionItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([status, startAt, endAt])
}

model PromotionItem {
  id String @id @default(uuid())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([promotionId, skuId])
  @@index([promotionId])
  @@index([skuId])
}

model WapiDelivery {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation("OrderWapiDeliveries", fields: [orderId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserWapiDeliveries", fields: [userId], references: [id], onDelete: Cascade)

  phone   String
  message String @db.Text

  status WapiDeliveryStatus @default(PENDING)

  messageId String?
  jid       String?

  attempts            Int       @default(0)
  errorMessage        String?   @db.Text
  processingStartedAt DateTime?
  sentAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, userId])
  @@index([status])
  @@index([orderId])
  @@index([userId])
}


// ============================================================
// CUSTOMER WHATSAPP DELIVERY
// ============================================================
//
// Separate ledger for customer-facing transactional WhatsApp.
// This intentionally does not reuse WapiDelivery because the
// existing WapiDelivery contract is one row per order/customer,
// while a customer may receive multiple lifecycle events for one
// order (payment, shipping, completed, reward, etc.).
// ============================================================

model WapiCustomerAuditLog {
  id String @id @default(uuid())

  actorId String?
  actor User? @relation("WapiCustomerAuditActors", fields: [actorId], references: [id], onDelete: SetNull)

  deliveryId String?
  delivery WapiCustomerDelivery? @relation("WapiCustomerDeliveryAuditLogs", fields: [deliveryId], references: [id], onDelete: SetNull)

  action String
  settingKey String?
  eventType String?
  fromStatus WapiDeliveryStatus?
  toStatus WapiDeliveryStatus?

  previousValue Json?
  newValue Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([deliveryId, createdAt])
  @@index([action, createdAt])
  @@index([settingKey, createdAt])
}

model WapiCustomerDelivery {
  id String @id @default(uuid())

  userId String
  user User @relation("UserWapiCustomerDeliveries", fields: [userId], references: [id], onDelete: Cascade)

  orderId String?
  order Order? @relation("OrderWapiCustomerDeliveries", fields: [orderId], references: [id], onDelete: Cascade)

  auditLogs WapiCustomerAuditLog[] @relation("WapiCustomerDeliveryAuditLogs")

  eventKey String @unique
  eventType String

  phone String
  message String @db.Text

  status WapiDeliveryStatus @default(PENDING)

  messageId String?
  jid String?

  attempts Int @default(0)
  errorMessage String? @db.Text
  processingStartedAt DateTime?
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([eventType, createdAt])
}




// ============================================================
// COURIER SLA SETTINGS
// ============================================================
//
// One active global SLA configuration is used by courier
// performance reporting. Historical assignment timestamps remain
// the source of truth; this model only defines the thresholds.
// ============================================================

model CourierSlaSettings {
  id String @id @default(uuid())

  assignmentToStartMinutes Int @default(15)
  startToPickupMinutes     Int @default(30)
  pickupToDeliveryMinutes  Int @default(60)
  totalDeliveryMinutes     Int @default(105)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedById String?
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([updatedById])
}

// ============================================================
// INTERNAL COURIER ASSIGNMENT
// ============================================================

model CourierAssignment {
  id String @id @default(uuid())

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  courierId String
  courier User @relation("CourierAssignments", fields: [courierId], references: [id], onDelete: Restrict)

  assignedById String?
  assignedBy User? @relation("CourierAssignmentsAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  status CourierAssignmentStatus @default(ASSIGNED)

  // SLA snapshot captured when this assignment is created.
  // Historical assignments must remain evaluated against the SLA
  // that was active at assignment time, even if global settings change.
  slaAssignmentToStartMinutes Int?
  slaStartToPickupMinutes     Int?
  slaPickupToDeliveryMinutes  Int?
  slaTotalDeliveryMinutes     Int?

  isActive Boolean @default(true)

  /// Null for historical/inactive assignments; orderId for the active assignment.
  /// A nullable unique key gives one active assignment per order while preserving history.
  activeAssignmentKey String? @unique

  assignedAt DateTime @default(now())
  startedAt DateTime?
  pickedUpAt DateTime?
  deliveredAt DateTime?
  failedAt DateTime?

  failureCode CourierFailureCode?

  failureReason String? @db.Text

  events CourierAssignmentEvent[]

  deliveryProof CourierDeliveryProof?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId, isActive])
  @@index([courierId, status])
  @@index([assignedAt])
  @@index([deliveredAt])
  @@index([failedAt])
  @@index([failureCode])
}


// ============================================================
// COURIER ASSIGNMENT AUDIT EVENT
// ============================================================

model CourierAssignmentEvent {
  id String @id @default(uuid())

  assignmentId String
  assignment CourierAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  actorId String?
  actor User? @relation("CourierAssignmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  type CourierAssignmentEventType
  fromStatus CourierAssignmentStatus?
  toStatus CourierAssignmentStatus?
  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([assignmentId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

// ============================================================
// COURIER DELIVERY PROOF
// ============================================================

model CourierDeliveryProof {
  id String @id @default(uuid())

  assignmentId String @unique
  assignment CourierAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  recipientName String
  recipientNote String? @db.Text
  photoUrl String?

  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  capturedAt DateTime @default(now())

  createdById String?
  createdBy User? @relation("CourierDeliveryProofCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  usedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([capturedAt])
}
