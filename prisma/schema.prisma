/**
 * ============================================================
 * VOUCHER
 * ============================================================
 * Menyimpan konfigurasi voucher yang dapat digunakan
 * oleh customer saat checkout.
 */

model Voucher {
  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  code String @unique

  name String

  description String?

  /**
   * ============================================================
   * VOUCHER TYPE
   * ============================================================
   * DISCOUNT = potongan subtotal produk.
   * FREE_SHIPPING = subsidi ongkir.
   */
  type VoucherType @default(DISCOUNT)

  /**
   * Voucher yang ditandai claimable wajib dimiliki customer
   * melalui UserVoucher sebelum dapat digunakan.
   */
  claimable Boolean @default(false)

  /**
   * Batas jumlah customer yang dapat melakukan claim.
   * null = unlimited.
   */
  claimLimit Int?
  claimCount Int  @default(0)

  /**
   * Maksimum subsidi ongkir untuk FREE_SHIPPING.
   * null = seluruh ongkir.
   */
  maximumShippingDiscount Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * DISCOUNT
   * ============================================================
   */

  discountType VoucherDiscountType

  discountValue Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * PURCHASE REQUIREMENT
   * ============================================================
   * Minimum subtotal agar voucher dapat digunakan.
   */

  minimumPurchase Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * MAXIMUM DISCOUNT
   * ============================================================
   * Digunakan terutama untuk percentage voucher.
   * Contoh:
   * Diskon 20%
   * Maximum Discount Rp25.000
   */

  maximumDiscount Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * VALIDITY PERIOD
   * ============================================================
   */

  startAt DateTime?

  endAt DateTime?

  /**
   * ============================================================
   * USAGE LIMIT
   * ============================================================
   * usageLimit:
   * null = unlimited
   * usageCount:
   * jumlah voucher yang sudah digunakan.
   */

  usageLimit Int?

  usageCount Int @default(0)

  /**
   * ============================================================
   * PER USER LIMIT
   * ============================================================
   * null = unlimited
   */

  perUserLimit Int?

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  orders Order[]

  userVouchers UserVoucher[]

  usages VoucherUsage[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([code])
  @@index([isActive])
  @@index([startAt])
  @@index([endAt])
  @@index([deletedAt])
}

// ============================================================
// REWARD VOUCHER SETTING
// ============================================================
//
// Konfigurasi reward yang dapat ditukar menggunakan point.
//
// Contoh:
//
// 500 Point
//     ↓
// Voucher Rp1.000
//
// 1.000 Point
//     ↓
// Voucher Rp2.500
//
// 2.000 Point
//     ↓
// Voucher 5%
//
// Setting ini dikelola dari Admin.
// ============================================================

model RewardVoucherSetting {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  /**
   * ============================================================
   * REQUIRED POINT
   * ============================================================
   * Jumlah point yang harus dimiliki customer
   * untuk menukarkan reward ini.
   * Contoh:
   * 500
   * 1000
   * 2000
   */

  requiredPoints Int

  /**
   * ============================================================
   * VOUCHER DISCOUNT
   * ============================================================
   * Menggunakan enum VoucherDiscountType yang sudah
   * digunakan oleh sistem Voucher.
   * PERCENTAGE
   * FIXED_AMOUNT
   */

  discountType VoucherDiscountType

  discountValue Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * MINIMUM PURCHASE
   * ============================================================
   * Optional.
   * Contoh:
   * Voucher Rp10.000
   * Minimum pembelian Rp50.000
   */

  minimumPurchase Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * MAXIMUM DISCOUNT
   * ============================================================
   * Relevan terutama untuk percentage voucher.
   * Contoh:
   * 5%
   * maximum discount Rp20.000
   */

  maximumDiscount Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   * Menentukan urutan reward pada halaman customer.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATION
   * ============================================================
   */

  userVouchers UserVoucher[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([requiredPoints])
  @@index([isActive])
  @@index([sortOrder])
}

