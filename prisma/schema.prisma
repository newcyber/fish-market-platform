// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  WAITING_VERIFICATION
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentChannelType {
  BANK_TRANSFER
  QRIS
}

enum StockLedgerType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCEL
}

enum NotificationType {
  NEW_ORDER
  PAYMENT_PROOF
  PAYMENT_VERIFIED
  ORDER_STATUS
  SYSTEM
}

enum ProductDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  passwordChangedAt DateTime?

  phone         String?   @unique
  avatar        String?
  emailVerified DateTime?

  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)

  addresses Address[]
  orders    Order[]
  cart      Cart?

  voucherUsages VoucherUsage[]

  accounts Account[]
  sessions Session[]

  passwordResetTokens PasswordResetToken[]

  emailVerificationOtps EmailVerificationOtp[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  wishlist Wishlist?

  @@index([email])
  @@index([role])
}

// ============================================================
// PASSWORD RESET TOKEN
// ============================================================

model PasswordResetToken {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * TOKEN SECURITY
   * ============================================================
   * Raw token TIDAK disimpan di database.
   * Yang disimpan hanya hash dari token.
   */

  tokenHash String @unique

  /**
   * ============================================================
   * EXPIRATION
   * ============================================================
   */

  expiresAt DateTime

  /**
   * ============================================================
   * SINGLE USE
   * ============================================================
   * null = belum digunakan
   * DateTime = sudah digunakan
   */

  usedAt DateTime?

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

// ============================================================
// EMAIL VERIFICATION OTP
// ============================================================

model EmailVerificationOtp {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * OTP SECURITY
   * ============================================================
   * OTP tidak disimpan dalam bentuk raw/plain text.
   * Yang disimpan hanya hash OTP.
   */

  codeHash String

  /**
   * ============================================================
   * EXPIRATION
   * ============================================================
   */

  expiresAt DateTime

  /**
   * ============================================================
   * SINGLE USE
   * ============================================================
   * null     = belum digunakan
   * DateTime = sudah berhasil digunakan
   */

  usedAt DateTime?

  /**
   * ============================================================
   * SECURITY
   * ============================================================
   * Jumlah percobaan memasukkan OTP.
   */

  attempts Int @default(0)

  /**
   * ============================================================
   * RESEND CONTROL
   * ============================================================
   * Digunakan untuk membatasi pengiriman OTP berulang.
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Cart {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CartItem {
  id String @id @default(uuid())

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id])

  /**
   * ============================================================
   * PRODUCT OPTIONS
   * ============================================================
   */

  productVariant String?

  productWeight String?

  /**
   * ============================================================
   * WEIGHT SKU SNAPSHOT
   * ============================================================
   * SKU dari pilihan berat yang dipilih customer.
   * Disimpan sebagai snapshot agar cart tetap mengetahui
   * SKU pilihan yang sedang dibeli.
   */

  weightSku String?

  /**
   * ============================================================
   * CUSTOMER NOTE
   * ============================================================
   */

  customerNote String?

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * PRICE
   * ============================================================
   */

  price Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  /**
   * ============================================================
   * UNIQUE CART ITEM
   * ============================================================
   */

  @@unique([cartId, productId, productVariant, productWeight])
  @@index([cartId])
  @@index([productId])
}

model Address {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[] // <-- WAJIB ADA

  receiverName  String
  receiverPhone String

  province String
  city     String
  district String
  village  String

  postalCode  String
  fullAddress String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  label String?
  notes String?

  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model Category {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

  image String?

  description String?

  /**
   * ============================================================
   * DISPLAY ORDER
   * ============================================================
   * Digunakan untuk menentukan urutan kategori.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   * true  = kategori aktif
   * false = kategori nonaktif
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  products Product[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * SOFT DELETE
   * ============================================================
   */

  deletedAt DateTime?

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Product {
  id String @id @default(uuid())

  /**
   * ============================================================
   * CATEGORY RELATION
   * ============================================================
   */

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  /**
   * ============================================================
   * PRODUCT INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

  description String?

  sku String? @unique

  price Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * PRODUCT DISCOUNT
   * ============================================================
   * Diskon diterapkan oleh ProductPricingService.
   * Contoh:
   * PERCENTAGE + 10
   * = diskon 10%
   * FIXED_AMOUNT + 5000
   * = diskon Rp5.000
   */

  isDiscountActive Boolean @default(false)

  discountType ProductDiscountType?

  discountValue Decimal? @db.Decimal(12, 2)

  discountStartAt DateTime?

  discountEndAt DateTime?

  stock Int @default(0)

  isPublished Boolean @default(true)

  featured Boolean @default(false)

  images ProductImage[]

  variantOptions ProductVariantOption[]

  weightOptions ProductWeightOption[] @relation("ProductWeightOptions")

  stockLedgers StockLedger[] @relation("ProductStockLedgers")

  orderItems OrderItem[]

  cartItems CartItem[]

  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([categoryId])
  @@index([slug])
  @@index([isDiscountActive])
  @@index([discountStartAt])
  @@index([discountEndAt])
}

/**
 * ============================================================
 * PRODUCT WEIGHT OPTION
 * ============================================================
 * Menyimpan pilihan berat yang tersedia
 * untuk setiap produk.
 * Contoh:
 * Produk Ikan Tuna:
 * - 250gr
 * - 500gr
 * - 1kg
 * Produk Udang:
 * - 500gr
 * - 1kg
 * - 2kg
 */
model ProductWeightOption {
  id String @id @default(uuid())

  productId String

  product Product @relation("ProductWeightOptions", fields: [productId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * WEIGHT LABEL
   * ============================================================
   * Contoh:
   * - 250gr
   * - 500gr
   * - 1kg
   */

  label String

  /**
   * ============================================================
   * SKU
   * ============================================================
   * SKU khusus untuk pilihan berat produk.
   * Contoh:
   * 250gr -> CMA-250
   * 500gr -> CMA-500
   * 1kg   -> CMA-1000
   * Nullable sementara agar migration aman untuk
   * data pilihan berat yang sudah ada.
   */

  sku String?

  /**
   * ============================================================
   * PRICE
   * ============================================================
   */

  price Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([productId, label])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([sortOrder])
}

/**
 * ============================================================
 * PRODUCT VARIANT OPTION
 * ============================================================
 * Menyimpan pilihan varian produk.
 * Contoh:
 * Ikan:
 * - Utuh
 * - Dibersihkan
 * - Fillet
 */

model ProductVariantOption {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * DISPLAY VALUE
   * ============================================================
   * Contoh:
   * - Utuh
   * - Dibersihkan
   * - Fillet
   */

  label String

  /**
   * ============================================================
   * PRICE ADJUSTMENT
   * ============================================================
   * Tambahan harga berdasarkan varian.
   * Contoh:
   * Utuh         = 0
   * Dibersihkan  = 5000
   * Fillet       = 10000
   * Nilai ini akan ditambahkan ke harga dasar
   * atau harga berdasarkan pilihan berat.
   */

  priceAdjustment Decimal @default(0) @db.Decimal(12, 2)

  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  /**
   * Satu produk tidak boleh memiliki
   * varian dengan nama yang sama.
   */

  @@unique([productId, label])
  @@index([productId])
  @@index([isActive])
  @@index([sortOrder])
}

model StockLedger {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation("ProductStockLedgers", fields: [productId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   */

  orderId String?

  order Order? @relation("OrderStockLedgers", fields: [orderId], references: [id], onDelete: SetNull)

  /**
   * ============================================================
   * LEDGER TYPE
   * ============================================================
   */

  type StockLedgerType

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * STOCK SNAPSHOT
   * ============================================================
   */

  stockBefore Int

  stockAfter Int

  /**
   * ============================================================
   * NOTE
   * ============================================================
   */

  note String?

  /**
   * ============================================================
   * TIMESTAMP
   * ============================================================
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([productId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model ProductImage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  image String

  sortOrder   Int     @default(0)
  isThumbnail Boolean @default(false)

  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod PaymentMethod

  /**
   * ============================================================
   * PAYMENT CHANNEL
   * ============================================================
   * Metode/channel pembayaran spesifik yang dipilih customer.
   * Contoh:
   * - BCA
   * - BRI
   * - Mandiri
   * - BNI
   */
  paymentChannelId String?

  paymentChannel PaymentChannel? @relation(fields: [paymentChannelId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * VOUCHER SNAPSHOT
   * ============================================================
   * Informasi voucher yang digunakan saat order dibuat.
   * Snapshot disimpan agar perubahan konfigurasi voucher
   * di masa depan tidak mengubah riwayat order.
   */

  voucherId String?

  voucherCode String?

  voucherName String?

  voucherDiscount Decimal @default(0) @db.Decimal(12, 2)

  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  shippingCost Decimal @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  notes String?

  /**
   * ============================================================
   * PAYMENT TIMESTAMP
   * ============================================================
   */

  paidAt DateTime?

  /**
   * ============================================================
   * INTERNAL SHIPPING
   * ============================================================
   * Digunakan untuk sistem pengiriman Fish Market.
   * Saat ini:
   * - INTERNAL
   * Masa depan dapat mendukung:
   * - JNE
   * - J&T
   * - SiCepat
   * - AnterAja
   * - POS
   */

  shippingProvider String?

  shippingService String?

  trackingNumber String? @unique

  shippedAt DateTime?

  /**
   * ============================================================
   * LEGACY / COMPATIBILITY
   * ============================================================
   * Dipertahankan sementara agar tidak merusak kode lama
   * yang mungkin masih menggunakan shippingAt.
   */

  shippingAt DateTime?

  completedAt DateTime?

  items OrderItem[]

  paymentProof PaymentProof?

  deletedAt DateTime?

  stockLedgers StockLedger[] @relation("OrderStockLedgers")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  voucherUsage VoucherUsage?

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([voucherId])
  @@index([voucherCode])
}

model OrderItem {
  id String @id @default(uuid())

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   */

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation(fields: [productId], references: [id])

  /**
   * ============================================================
   * PRODUCT SNAPSHOT
   * ============================================================
   */

  productName String

  /**
   * ============================================================
   * PRODUCT OPTIONS
   * ============================================================
   */

  productVariant String?

  productWeight String?

  /**
   * ============================================================
   * WEIGHT SKU SNAPSHOT
   * ============================================================
   * SKU pilihan berat saat checkout.
   * Nilai ini disimpan permanen agar:
   * - Resi pesanan lama tetap konsisten
   * - Riwayat order tidak berubah
   * - Perubahan SKU produk di masa depan
   * tidak mempengaruhi pesanan lama
   */

  weightSku String?

  /**
   * ============================================================
   * CUSTOMER NOTE
   * ============================================================
   */

  customerNote String?

  /**
   * ============================================================
   * PRICE
   * ============================================================
   */

  price Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * SUBTOTAL
   * ============================================================
   */

  subtotal Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([orderId])
  @@index([productId])
}

/**
 * ============================================================
 * VOUCHER
 * ============================================================
 * Menyimpan konfigurasi voucher yang dapat digunakan
 * oleh customer saat checkout.
 */

model Voucher {
  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  code String @unique

  name String

  description String?

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * DISCOUNT
   * ============================================================
   */

  discountType VoucherDiscountType

  discountValue Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * PURCHASE REQUIREMENT
   * ============================================================
   * Minimum subtotal agar voucher dapat digunakan.
   */

  minimumPurchase Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * MAXIMUM DISCOUNT
   * ============================================================
   * Digunakan terutama untuk percentage voucher.
   * Contoh:
   * Diskon 20%
   * Maximum Discount Rp25.000
   */

  maximumDiscount Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * VALIDITY PERIOD
   * ============================================================
   */

  startAt DateTime?

  endAt DateTime?

  /**
   * ============================================================
   * USAGE LIMIT
   * ============================================================
   * usageLimit:
   * null = unlimited
   * usageCount:
   * jumlah voucher yang sudah digunakan.
   */

  usageLimit Int?

  usageCount Int @default(0)

  /**
   * ============================================================
   * PER USER LIMIT
   * ============================================================
   * null = unlimited
   */

  perUserLimit Int?

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  orders Order[]

  usages VoucherUsage[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([code])
  @@index([isActive])
  @@index([startAt])
  @@index([endAt])
  @@index([deletedAt])
}

/**
 * ============================================================
 * VOUCHER USAGE
 * ============================================================
 * Mencatat penggunaan voucher oleh customer.
 * Data ini digunakan untuk:
 * - perUserLimit
 * - audit penggunaan voucher
 * - riwayat voucher
 */

model VoucherUsage {
  id String @id @default(uuid())

  /**
   * ============================================================
   * VOUCHER
   * ============================================================
   */

  voucherId String

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  /**
   * ============================================================
   * USER
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * ORDER
   * ============================================================
   * Satu order hanya boleh memiliki
   * satu record penggunaan voucher.
   */

  orderId String @unique

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * VOUCHER SNAPSHOT
   * ============================================================
   * Menyimpan nominal diskon aktual yang digunakan.
   */

  discountAmount Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * TIMESTAMP
   * ============================================================
   */

  usedAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([voucherId])
  @@index([userId])
  @@index([voucherId, userId])
  @@index([usedAt])
}

model PaymentProof {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  image String?

  bankName String?

  accountName String?

  accountNumber String?

  status PaymentStatus @default(PENDING)

  verifiedAt DateTime?

  verifiedById String?

  rejectionReason String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Account {
  id String @id @default(cuid())

  userId String

  type String

  provider String

  providerAccountId String

  refresh_token String? @db.Text

  access_token String? @db.Text

  expires_at Int?

  token_type String?

  scope String?

  id_token String? @db.Text

  session_state String?

  oauth_token String?

  oauth_token_secret String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String

  token String @unique

  expires DateTime

  @@unique([identifier, token])
}

model PaymentChannel {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(cuid())

  /**
   * ============================================================
   * IDENTITY
   * ============================================================
   */

  name String

  slug String @unique

  type PaymentChannelType @default(BANK_TRANSFER)

  /**
   * ============================================================
   * BANK INFORMATION
   * ============================================================
   */

  bankName String?

  accountNumber String?

  accountHolder String?

  /**
   * ============================================================
   * PAYMENT INSTRUCTION
   * ============================================================
   */

  instructions String?

  /**
   * ============================================================
   * QRIS IMAGE
   * ============================================================
   * Menyimpan URL/path gambar QRIS.
   * Digunakan hanya untuk payment channel
   * dengan type QRIS.
   * Contoh:
   * /uploads/payments/qris.png
   * atau URL storage.
   */

  qrisImage String?

  /**
   * ============================================================
   * DISPLAY
   * ============================================================
   */

  description String?

  icon String?

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   */

  orders Order[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([isActive])
  @@index([type])
  @@index([sortOrder])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// WISHLIST ITEM
// ============================================================

model WishlistItem {
  id String @id @default(uuid())

  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

// ============================================================
// STORE SETTINGS
// ============================================================

model StoreSettings {
  id String @id @default(uuid())

  // ----------------------------------------------------------
  // INFORMASI TOKO
  // ----------------------------------------------------------

  storeName        String  @default("Fish Market")
  storeDescription String?

  footerDescription String?

  /**
   * URL atau path logo situs.
   * null berarti sistem menggunakan fallback logo default.
   */
  siteLogo String?

  email    String?
  whatsapp String?

  // ----------------------------------------------------------
  // ALAMAT TOKO
  // ----------------------------------------------------------

  address    String?
  city       String?
  province   String?
  postalCode String?

  // ==========================================================
  // STORE LOCATION / SHIPPING ORIGIN
  // ==========================================================

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // ==========================================================
  // INTERNAL SHIPPING CONFIGURATION
  // ==========================================================

  internalShippingEnabled Boolean @default(true)

  internalShippingName String @default("Kurir Internal")

  internalShippingBaseFee Decimal @default(0) @db.Decimal(12, 2)

  internalShippingPerKmFee Decimal @default(0) @db.Decimal(12, 2)

  internalShippingMaxDistance Decimal @default(10) @db.Decimal(10, 2)

  internalShippingFreeThreshold Decimal? @db.Decimal(14, 2)

  // ----------------------------------------------------------
  // OPERASIONAL
  // ----------------------------------------------------------

  openingTime String?
  closingTime String?

  // ----------------------------------------------------------
  // TIMESTAMP
  // ----------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  type NotificationType

  href String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}
