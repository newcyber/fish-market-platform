// ============================================================
// REWARD CATALOG
// ============================================================

// ============================================================
// REWARD CATALOG
// ============================================================
//
// Katalog hadiah fisik yang dapat ditukar menggunakan
// reward point.
//
// Contoh:
//
// TV Samsung 43"
//     25.000 Point
//
// Kulkas
//     30.000 Point
//
// Sepeda Gunung
//     15.000 Point
//
// Data ini dikelola oleh Admin.
// ============================================================

model RewardCatalog {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  description String?

  image String?

  /**
   * ============================================================
   * REWARD CATEGORY
   * ============================================================
   * Nullable sementara pada tahap migrasi agar RewardCatalog
   * existing tidak rusak.
   * Setelah category master dan assignment selesai,
   * field ini akan kita enforce menjadi required.
   */

  categoryId String?

  category RewardCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * REQUIRED POINT
   * ============================================================
   * Jumlah point yang diperlukan customer
   * untuk melakukan claim satu hadiah.
   */

  requiredPoints Int

  /**
   * ============================================================
   * STOCK
   * ============================================================
   * Jumlah hadiah yang masih tersedia.
   * Satu RewardClaim akan mengurangi stock sebesar 1.
   */

  stock Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   * Menentukan urutan hadiah pada katalog customer.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATION
   * ============================================================
   */

  claims RewardClaim[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([categoryId])
  @@index([isActive])
  @@index([requiredPoints])
  @@index([sortOrder])
}

// ============================================================
// REWARD CLAIM
// ============================================================
//
// Mencatat customer yang menukarkan reward point
// dengan hadiah fisik.
//
// Satu RewardClaim = satu unit hadiah.
//
// Contoh:
//
// Customer
//     ↓
// Claim TV
//     ↓
// 25.000 point
//
// Point:
//     REDEEM -25.000
//
// Stock:
//     -1
// ============================================================

model RewardClaim {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * CUSTOMER
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rewardPointTransactions RewardPointTransaction[]

  /**
   * ============================================================
   * REWARD CATALOG
   * ============================================================
   */

  rewardCatalogId String

  /**
   * ============================================================
   * SHIPPING ADDRESS SNAPSHOT
   * ============================================================
   * Alamat dibekukan pada saat customer melakukan claim.
   * Perubahan alamat customer setelah claim tidak mengubah
   * tujuan pengiriman reward yang sudah dibuat.
   */

  receiverName  String
  receiverPhone String

  province String
  city     String
  district String
  village  String

  postalCode  String
  fullAddress String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  rewardCatalog RewardCatalog @relation(fields: [rewardCatalogId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * POINT SNAPSHOT
   * ============================================================
   * Jumlah point yang benar-benar digunakan
   * ketika claim dibuat.
   * Tidak mengambil kembali dari RewardCatalog
   * karena konfigurasi hadiah dapat berubah
   * di masa depan.
   */

  pointsSpent Int

  /**
   * ============================================================
   * REWARD SNAPSHOT
   * ============================================================
   * Snapshot diperlukan agar histori claim
   * tidak berubah ketika Admin mengedit katalog.
   */

  rewardName String

  rewardDescription String?

  rewardImage String?

  /**
   * ============================================================
   * CLAIM STATUS
   * ============================================================
   */

  status RewardClaimStatus @default(PENDING)

  /**
   * ============================================================
   * REJECTION
   * ============================================================
   * Diisi ketika claim ditolak.
   */

  rejectionReason String?

  /**
   * ============================================================
   * REFUND
   * ============================================================
   * Diisi ketika point dikembalikan karena claim ditolak
   * atau dibatalkan sebelum fulfillment.
   * null = point belum dikembalikan
   * DateTime = point sudah dikembalikan
   */
  refundedAt DateTime?

  /**
   * ============================================================
   * STATUS TIMESTAMPS
   * ============================================================
   */

  approvedAt DateTime?

  shippedAt DateTime?

  completedAt DateTime?

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([rewardCatalogId])
  @@index([status])
  @@index([userId, createdAt])
}

// ============================================================
// USER VOUCHER
// ============================================================
//
// Voucher hasil penukaran reward point.
//
// Satu record UserVoucher berarti:
// customer tertentu telah menukarkan reward tertentu
// dan mendapatkan Voucher tertentu.
//
// Contoh:
//
// User
//   ↓
// UserVoucher
//   ├── RewardVoucherSetting
//   └── Voucher
// ============================================================

model UserVoucher {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Nullable untuk voucher promo biasa yang diklaim customer.
   * Tetap terisi untuk voucher hasil redeem reward point.
   */
  rewardVoucherSettingId String?
  rewardVoucherSetting   RewardVoucherSetting? @relation(fields: [rewardVoucherSettingId], references: [id], onDelete: Restrict)

  /**
   * Satu voucher campaign dapat dimiliki banyak customer.
   */
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  pointsSpent Int @default(0)

  /**
   * Waktu customer mendapatkan voucher.
   * Nama redeemedAt dipertahankan untuk kompatibilitas reward voucher lama.
   */
  redeemedAt DateTime @default(now())
  claimedAt  DateTime @default(now())

  @@unique([userId, voucherId])
  @@index([userId])
  @@index([voucherId])
  @@index([rewardVoucherSettingId])
  @@index([userId, redeemedAt])
  @@index([userId, claimedAt])
}

/**
