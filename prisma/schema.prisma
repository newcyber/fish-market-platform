// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// DATABASE BACKUP
// ============================================================
//
// Metadata/audit record for logical PostgreSQL backups.
// The actual archive is stored outside the application/database.
// ============================================================

model DatabaseBackup {
  id           String             @id @default(uuid())
  filename     String             @unique
  storageKey   String?
  sizeBytes    BigInt?
  checksum     String?
  status       DatabaseBackupStatus @default(RUNNING)
  backupType   DatabaseBackupType  @default(MANUAL)
  startedAt    DateTime            @default(now())
  completedAt  DateTime?
  verifiedAt   DateTime?
  errorMessage String?             @db.Text
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([backupType])
  @@index([startedAt])
}

enum DatabaseBackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DatabaseBackupType {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  COURIER
}

