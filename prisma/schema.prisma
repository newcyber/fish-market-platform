   * = Flash Sale berlaku untuk seluruh pilihan berat.
   * value
   * = Flash Sale hanya berlaku untuk berat tertentu.
   */

  weightOptionId String?

  weightOption ProductWeightOption? @relation(fields: [weightOptionId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * PRICE SNAPSHOT
   * ============================================================
