// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum RewardPointTransactionType {
  EARN
  REDEEM
  REFUND
  ADJUSTMENT
  EXPIRED
}

enum RewardClaimStatus {
  PENDING
  APPROVED
  PROCESSING
  SHIPPED
  COMPLETED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  WAITING_VERIFICATION
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentChannelType {
  BANK_TRANSFER
  QRIS
}

enum StockLedgerType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCEL
}

enum NotificationType {
  NEW_ORDER
  PAYMENT_PROOF
  PAYMENT_VERIFIED
  ORDER_STATUS
  SYSTEM
}

enum ProductDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum FlashSaleStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum PromotionType {
  MARKETING
  PRICE_DISCOUNT
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  passwordChangedAt DateTime?

  phone         String?   @unique
  avatar        String?
  emailVerified DateTime?

  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)

  addresses Address[]
  orders    Order[]
  cart      Cart?

  voucherUsages VoucherUsage[]

  flashSalePurchases FlashSalePurchase[]

  notifications Notification[]

  pushSubscriptions PushSubscription[]

  accounts Account[]
  sessions Session[]

  mobileSessions MobileSession[]

  passwordResetTokens PasswordResetToken[]

  emailVerificationOtps EmailVerificationOtp[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  wishlist Wishlist?

  /**
   * ============================================================
   * REWARD POINTS
   * ============================================================
   * Saldo poin reward customer saat ini.
   * Nilai ini merupakan cached balance.
   * Seluruh perubahan tetap dicatat di
   * RewardPointTransaction sebagai ledger.
   */

  rewardPointsBalance Int @default(0)

  rewardPointTransactions RewardPointTransaction[]

  userVouchers UserVoucher[]

  rewardClaims RewardClaim[]

  @@index([email])
  @@index([role])
}

// ============================================================
// REWARD POINT TRANSACTION
// ============================================================

model RewardPointTransaction {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   * Diisi ketika transaksi reward berasal dari order.
   * Contoh:
   * COMPLETED
   * ↓
   * EARN
   * ↓
   * orderId = order tersebut
   * Untuk transaksi manual seperti ADJUSTMENT,
   * orderId dapat bernilai null.
   */

  orderId String?

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /**
   * ============================================================
   * REWARD CLAIM RELATION
   * ============================================================
   * Digunakan untuk menghubungkan transaksi point
   * dengan claim reward fisik.
   * Satu RewardClaim dapat memiliki:
   * REDEEM  -N
   * REFUND  +N
   * sehingga rewardClaimId TIDAK boleh unique.
   */

  rewardClaimId String?

  rewardClaim RewardClaim? @relation(fields: [rewardClaimId], references: [id], onDelete: SetNull)

  /**
   * ============================================================
   * TRANSACTION TYPE
   * ============================================================
   */

  type RewardPointTransactionType

  /**
   * ============================================================
   * POINTS
   * ============================================================
   * Nilai transaksi.
   * EARN:
   * +15
   * REDEEM:
   * -25
   * ADJUSTMENT:
   * dapat positif atau negatif
   * EXPIRED:
   * -10
   */

  points Int

  /**
   * ============================================================
   * WEIGHT SNAPSHOT
   * ============================================================
   * Total berat yang digunakan ketika poin EARN dihitung.
   * Disimpan sebagai gram agar tidak bergantung pada
   * format string seperti "1 KG", "500 GR", dan sebagainya.
   * Null untuk transaksi yang tidak berasal dari pembelian.
   */

  weightGrams Int?

  /**
   * ============================================================
   * DESCRIPTION
   * ============================================================
   */

  description String?

  /**
   * ============================================================
   * TIMESTAMP
   * ============================================================
   */

  rewardViewedAt DateTime?

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@unique([orderId, type])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
  @@index([rewardClaimId])
}

// ============================================================
// PASSWORD RESET TOKEN
// ============================================================

model PasswordResetToken {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * TOKEN SECURITY
   * ============================================================
   * Raw token TIDAK disimpan di database.
   * Yang disimpan hanya hash dari token.
   */

  tokenHash String @unique

  /**
   * ============================================================
   * EXPIRATION
   * ============================================================
   */

  expiresAt DateTime

  /**
   * ============================================================
   * SINGLE USE
   * ============================================================
   * null = belum digunakan
   * DateTime = sudah digunakan
   */

  usedAt DateTime?

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

// ============================================================
// EMAIL VERIFICATION OTP
// ============================================================

model EmailVerificationOtp {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * OTP SECURITY
   * ============================================================
   * OTP tidak disimpan dalam bentuk raw/plain text.
   * Yang disimpan hanya hash OTP.
   */

  codeHash String

  /**
   * ============================================================
   * EXPIRATION
   * ============================================================
   */

  expiresAt DateTime

  /**
   * ============================================================
   * SINGLE USE
   * ============================================================
   * null     = belum digunakan
   * DateTime = sudah berhasil digunakan
   */

  usedAt DateTime?

  /**
   * ============================================================
   * SECURITY
   * ============================================================
   * Jumlah percobaan memasukkan OTP.
   */

  attempts Int @default(0)

  /**
   * ============================================================
   * RESEND CONTROL
   * ============================================================
   * Digunakan untuk membatasi pengiriman OTP berulang.
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Cart {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CartItem {
  id String @id @default(uuid())

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id])

  /**
   * ============================================================
   * PRODUCT OPTIONS
   * ============================================================
   */

  productVariant String?

  productWeight String?

  /**
   * ============================================================
   * WEIGHT SKU SNAPSHOT
   * ============================================================
   * SKU dari pilihan berat yang dipilih customer.
   * Disimpan sebagai snapshot agar cart tetap mengetahui
   * SKU pilihan yang sedang dibeli.
   */

  weightSku String?

  /// New canonical sellable SKU. Nullable during migration.
  skuId String?
  sku   ProductSku? @relation("CartItemSku", fields: [skuId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * CUSTOMER NOTE
   * ============================================================
   */

  customerNote String?

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * PRICE
   * ============================================================
   * Snapshot harga satuan ketika item dimasukkan
   * ke dalam keranjang.
   */

  price Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * FLASH SALE SNAPSHOT
   * ============================================================
   * Cart tidak boleh menjadi sumber kebenaran final
   * untuk Flash Sale.
   * Field ini hanya menyimpan snapshot bahwa item
   * masuk ke cart menggunakan Flash Sale tertentu.
   * Saat checkout, Flash Sale wajib divalidasi ulang.
   */

  isFlashSaleApplied Boolean @default(false)

  flashSaleId String?

  flashSaleItemId String?

  /**
   * ============================================================
   * FLASH SALE RELATIONS
   * ============================================================
   */

  flashSale FlashSale? @relation("CartItemFlashSale", fields: [flashSaleId], references: [id], onDelete: SetNull)

  flashSaleItem FlashSaleItem? @relation("CartItemFlashSaleItem", fields: [flashSaleItemId], references: [id], onDelete: SetNull)

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  /**
   * ============================================================
   * UNIQUE CART ITEM
   * ============================================================
   */

  @@unique([cartId, productId, productVariant, productWeight])
  @@index([cartId])
  @@index([productId])
  @@index([skuId])
  @@index([flashSaleId])
  @@index([flashSaleItemId])
}

model Address {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[] // <-- WAJIB ADA

  receiverName  String
  receiverPhone String

  province String
  city     String
  district String
  village  String

  postalCode  String
  fullAddress String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  label String?
  notes String?

  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model Category {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

  image String?

  description String?

  /**
   * ============================================================
   * DISPLAY ORDER
   * ============================================================
   * Digunakan untuk menentukan urutan kategori.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   * true  = kategori aktif
   * false = kategori nonaktif
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  products Product[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * SOFT DELETE
   * ============================================================
   */

  deletedAt DateTime?

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Product {
  id String @id @default(uuid())

  /**
   * ============================================================
   * CATEGORY RELATION
   * ============================================================
   */

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  /**
   * ============================================================
   * PRODUCT INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

  description String?

  sku String? @unique

  /// LEGACY PRODUCT-LEVEL PRICE. SKU.price is canonical for variant products.
  price Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * PRODUCT DISCOUNT
   * ============================================================
   * Diskon diterapkan oleh ProductPricingService.
   * Contoh:
   * PERCENTAGE + 10
   * = diskon 10%
   * FIXED_AMOUNT + 5000
   * = diskon Rp5.000
   */

  isDiscountActive Boolean @default(false)

  discountType ProductDiscountType?

  discountValue Decimal? @db.Decimal(12, 2)

  discountStartAt DateTime?

  discountEndAt DateTime?

  /// LEGACY PRODUCT-LEVEL STOCK. SKU.stock becomes source-of-truth.
  stock Int @default(0)

  isPublished Boolean @default(true)

  featured Boolean @default(false)

  images ProductImage[]

  legacyVariantOptions LegacyProductVariantOption[] @relation("LegacyProductVariantOptions")

  variantGroups ProductVariantGroup[]

  skus ProductSku[]

  weightOptions ProductWeightOption[] @relation("ProductWeightOptions")

  weightVariantPrices ProductWeightVariantPrice[] @relation("ProductWeightVariantPriceProduct")

  flashSaleItems FlashSaleItem[]

  stockLedgers StockLedger[] @relation("ProductStockLedgers")

  orderItems OrderItem[]

  cartItems CartItem[]

  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([categoryId])
  @@index([slug])
  @@index([isDiscountActive])
  @@index([discountStartAt])
  @@index([discountEndAt])
}

/**
 * ============================================================
 * PRODUCT WEIGHT OPTION
 * ============================================================
 * Menyimpan pilihan berat yang tersedia
 * untuk setiap produk.
 * Contoh:
 * Produk Ikan Tuna:
 * - 250gr
 * - 500gr
 * - 1kg
 * Produk Udang:
 * - 500gr
 * - 1kg
 * - 2kg
 */
model ProductWeightOption {
  id String @id @default(uuid())

  productId String

  product Product @relation("ProductWeightOptions", fields: [productId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * WEIGHT LABEL
   * ============================================================
   * Contoh:
   * - 250gr
   * - 500gr
   * - 1kg
   */

  label String

  /**
   * ============================================================
   * SKU
   * ============================================================
   * SKU khusus untuk pilihan berat produk.
   * Contoh:
   * 250gr -> CMA-250
   * 500gr -> CMA-500
   * 1kg   -> CMA-1000
   * Nullable sementara agar migration aman untuk
   * data pilihan berat yang sudah ada.
   */

  sku String?

  /**
   * ============================================================
   * PRICE
   * ============================================================
   */

  weightVariantPrices ProductWeightVariantPrice[] @relation("ProductWeightVariantPriceWeight")

  price Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  flashSaleItems FlashSaleItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([productId, label])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([sortOrder])
}

/**
 * ============================================================
 * FLASH SALE
 * ============================================================
 * Campaign utama Flash Sale.
 * Contoh:
 * Flash Sale Akhir Pekan
 * startAt:
 * 2026-08-22 00:00
 * endAt:
 * 2026-08-24 23:59
 */
model FlashSale {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

  description String?

  /**
   * ============================================================
   * VISUAL
   * ============================================================
   */

  banner String?

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  status FlashSaleStatus @default(DRAFT)

  /**
   * ============================================================
   * SCHEDULE
   * ============================================================
   */

  startAt DateTime

  endAt DateTime

  /**
   * ============================================================
   * DISPLAY
   * ============================================================
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  items FlashSaleItem[]

  cartItems CartItem[] @relation("CartItemFlashSale")

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([slug])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([status, startAt, endAt])
}

/**
 * ============================================================
 * FLASH SALE ITEM
 * ============================================================
 * Produk atau pilihan berat produk yang mengikuti Flash Sale.
 */
model FlashSaleItem {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * FLASH SALE RELATION
   * ============================================================
   */

  flashSaleId String

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// New canonical sellable SKU. Nullable during migration.
  skuId String?
  sku   ProductSku? @relation("FlashSaleItemSku", fields: [skuId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * WEIGHT OPTION
   * ============================================================
   * null
   * = Flash Sale berlaku untuk seluruh pilihan berat.
   * value
   * = Flash Sale hanya berlaku untuk berat tertentu.
   */

  weightOptionId String?

  weightOption ProductWeightOption? @relation(fields: [weightOptionId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * PRICE SNAPSHOT
   * ============================================================
   * Harga normal saat item Flash Sale dikonfigurasi.
   * Field ini digunakan sebagai snapshot dan audit.
   */

  originalPrice Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * FLASH SALE PRICE
   * ============================================================
   */

  flashPrice Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * STOCK / QUOTA
   * ============================================================
   * stockLimit:
   * Total kuota unit yang tersedia untuk Flash Sale.
   * soldQuantity:
   * Jumlah unit yang sudah berhasil dialokasikan/dibeli.
   */

  stockLimit Int

  soldQuantity Int @default(0)

  /**
   * ============================================================
   * CUSTOMER PURCHASE LIMIT
   * ============================================================
   * null
   * = tidak ada batas per customer.
   * Contoh:
   * 2
   * = satu customer maksimal membeli 2 unit.
   */

  perUserLimit Int?

  /**
   * ============================================================
   * STATUS
   * ============================================================
   * Digunakan untuk menonaktifkan item tertentu tanpa
   * harus menghentikan seluruh campaign Flash Sale.
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * DISPLAY
   * ============================================================
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  purchases FlashSalePurchase[]

  cartItems CartItem[] @relation("CartItemFlashSaleItem")

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([flashSaleId])
  @@index([productId])
  @@index([skuId])
  @@index([weightOptionId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([flashSaleId, isActive])
}

/**
 * ============================================================
 * FLASH SALE PURCHASE
 * ============================================================
 * Mencatat pembelian Flash Sale.
 * Digunakan untuk:
 * - Per user limit
 * - Audit
 * - Riwayat Flash Sale
 * - Validasi checkout
 */
model FlashSalePurchase {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * FLASH SALE ITEM
   * ============================================================
   */

  flashSaleItemId String

  flashSaleItem FlashSaleItem @relation(fields: [flashSaleItemId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * USER
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * ORDER
   * ============================================================
   */

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * PRICE SNAPSHOT
   * ============================================================
   * Harga Flash Sale per unit saat checkout.
   */

  price Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * TIMESTAMP
   * ============================================================
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@unique([orderId, flashSaleItemId])
  @@index([flashSaleItemId])
  @@index([userId])
  @@index([orderId])
  @@index([flashSaleItemId, userId])
}

// ============================================================
// NEW FLEXIBLE PRODUCT VARIANT SYSTEM
// ============================================================

model ProductVariantGroup {
  id        String                 @id @default(uuid())
  productId String
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  options   ProductVariantOption[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@index([productId, sortOrder])
  @@index([isActive])
}

model ProductVariantOption {
  id         String              @id @default(uuid())
  groupId    String
  group      ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int                 @default(0)
  isActive   Boolean             @default(true)
  skuOptions ProductSkuOption[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([groupId, label])
  @@index([groupId])
  @@index([groupId, sortOrder])
  @@index([isActive])
  /// Temporary table name so the new model can coexist with the legacy table.
  @@map("ProductVariantOptionNew")
}

model ProductSku {
  id               String               @id @default(uuid())
  productId        String
  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String               @unique
  price            Decimal              @db.Decimal(12, 2)
  isDiscountActive Boolean              @default(false)
  discountType     ProductDiscountType?
  discountValue    Decimal?             @db.Decimal(12, 2)
  discountStartAt  DateTime?
  discountEndAt    DateTime?
  stock            Int                  @default(0)
  isActive         Boolean              @default(true)
  skuOptions       ProductSkuOption[]
  cartItems        CartItem[]           @relation("CartItemSku")
  orderItems       OrderItem[]          @relation("OrderItemSku")
  stockLedgers     StockLedger[]        @relation("StockLedgerSku")
  flashSaleItems   FlashSaleItem[]      @relation("FlashSaleItemSku")
  promotionItems   PromotionItem[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([productId])
  @@index([productId, isActive])
  @@index([stock])
  @@index([isDiscountActive])
  @@index([discountStartAt])
  @@index([discountEndAt])
}

model ProductSkuOption {
  id              String               @id @default(uuid())
  skuId           String
  sku             ProductSku           @relation(fields: [skuId], references: [id], onDelete: Cascade)
  variantOptionId String
  variantOption   ProductVariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())

  @@unique([skuId, variantOptionId])
  @@index([skuId])
  @@index([variantOptionId])
}

/**
 * ============================================================
 * PRODUCT VARIANT OPTION
 * ============================================================
 * Menyimpan pilihan varian produk.
 * Contoh:
 * Ikan:
 * - Utuh
 * - Dibersihkan
 * - Fillet
 */

model LegacyProductVariantOption {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation("LegacyProductVariantOptions", fields: [productId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * DISPLAY VALUE
   * ============================================================
   * Contoh:
   * - Utuh
   * - Dibersihkan
   * - Fillet
   */

  label String

  /**
   * ============================================================
   * PRICE ADJUSTMENT
   * ============================================================
   * Tambahan harga berdasarkan varian.
   * Contoh:
   * Utuh         = 0
   * Dibersihkan  = 5000
   * Fillet       = 10000
   * Nilai ini akan ditambahkan ke harga dasar
   * atau harga berdasarkan pilihan berat.
   */

  priceAdjustment Decimal @default(0) @db.Decimal(12, 2)

  weightVariantPrices ProductWeightVariantPrice[] @relation("ProductWeightVariantPriceVariant")
  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  /**
   * Satu produk tidak boleh memiliki
   * varian dengan nama yang sama.
   */

  @@unique([productId, label])
  @@index([productId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("ProductVariantOption")
}

/**
 * ============================================================
 * PRODUCT WEIGHT VARIANT PRICE
 * ============================================================
 * Menyimpan harga khusus berdasarkan kombinasi:
 * Product
 * + Weight
 * + Variant
 * Contoh:
 * 1 KG + Utuh         = 100000
 * 1 KG + Dibersihkan  = 105000
 * 2 KG + Utuh         = 200000
 * 2 KG + Dibersihkan  = 207000
 * 3 KG + Utuh         = 300000
 * 3 KG + Dibersihkan  = 210000
 * Harga di sini adalah HARGA FINAL NORMAL
 * untuk kombinasi tersebut, bukan adjustment.
 * ============================================================
 */

/**
 * ============================================================
 * PRODUCT WEIGHT VARIANT PRICE
 * ============================================================
 * Harga khusus berdasarkan kombinasi:
 * Product
 * + Weight
 * + Variant
 * Contoh:
 * 1 KG + Utuh         = 100000
 * 1 KG + Dibersihkan  = 105000
 * 2 KG + Utuh         = 200000
 * 2 KG + Dibersihkan  = 207000
 * 3 KG + Utuh         = 300000
 * 3 KG + Dibersihkan  = 210000
 * price = harga normal FINAL untuk kombinasi.
 * Bukan price adjustment.
 * ============================================================
 */

model ProductWeightVariantPrice {
  id String @id @default(cuid())

  /**
   * PRODUCT
   */
  productId String

  product Product @relation("ProductWeightVariantPriceProduct", fields: [productId], references: [id])

  /**
   * WEIGHT
   */
  weightOptionId String

  weightOption ProductWeightOption @relation("ProductWeightVariantPriceWeight", fields: [weightOptionId], references: [id])

  /**
   * VARIANT
   */
  variantOptionId String

  variantOption LegacyProductVariantOption @relation("ProductWeightVariantPriceVariant", fields: [variantOptionId], references: [id])

  /**
   * PRICE
   */
  price Decimal @db.Decimal(15, 2)

  /**
   * TIMESTAMPS
   */
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * UNIQUE COMBINATION
   */
  @@unique([productId, weightOptionId, variantOptionId])
  /**
   * INDEXES
   */
  @@index([productId])
  @@index([weightOptionId])
  @@index([variantOptionId])
  @@index([productId, weightOptionId])
  @@index([productId, variantOptionId])
}

model StockLedger {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation("ProductStockLedgers", fields: [productId], references: [id], onDelete: Cascade)

  /// New canonical stock owner. Nullable during migration.
  skuId String?
  sku   ProductSku? @relation("StockLedgerSku", fields: [skuId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   */

  orderId String?

