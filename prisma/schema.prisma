// ============================================================
// NEW FLEXIBLE PRODUCT VARIANT SYSTEM
// ============================================================

model ProductVariantGroup {
  id        String                 @id @default(uuid())
  productId String
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  options   ProductVariantOption[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@index([productId, sortOrder])
  @@index([isActive])
}

model ProductVariantOption {
  id         String              @id @default(uuid())
  groupId    String
  group      ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int                 @default(0)
  isActive   Boolean             @default(true)
  skuOptions ProductSkuOption[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([groupId, label])
  @@index([groupId])
  @@index([groupId, sortOrder])
  @@index([isActive])
  /// Temporary table name so the new model can coexist with the legacy table.
  @@map("ProductVariantOptionNew")
}

model ProductSku {
  id               String               @id @default(uuid())
  productId        String
  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String               @unique
  price            Decimal              @db.Decimal(12, 2)
  isDiscountActive Boolean              @default(false)
  discountType     ProductDiscountType?
  discountValue    Decimal?             @db.Decimal(12, 2)
  discountStartAt  DateTime?
  discountEndAt    DateTime?
  stock            Int                  @default(0)
  isActive         Boolean              @default(true)
  skuOptions       ProductSkuOption[]
  cartItems        CartItem[]           @relation("CartItemSku")
  orderItems       OrderItem[]          @relation("OrderItemSku")
  stockLedgers     StockLedger[]        @relation("StockLedgerSku")
  flashSaleItems   FlashSaleItem[]      @relation("FlashSaleItemSku")
  promotionItems   PromotionItem[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([productId])
  @@index([productId, isActive])
  @@index([stock])
  @@index([isDiscountActive])
  @@index([discountStartAt])
  @@index([discountEndAt])
}

model ProductSkuOption {
  id              String               @id @default(uuid())
  skuId           String
  sku             ProductSku           @relation(fields: [skuId], references: [id], onDelete: Cascade)
  variantOptionId String
  variantOption   ProductVariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now())

  @@unique([skuId, variantOptionId])
  @@index([skuId])
  @@index([variantOptionId])
}

/**
 * ============================================================
 * PRODUCT VARIANT OPTION
 * ============================================================
 * Menyimpan pilihan varian produk.
 * Contoh:
 * Ikan:
 * - Utuh
 * - Dibersihkan
 * - Fillet
 */

model LegacyProductVariantOption {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation("LegacyProductVariantOptions", fields: [productId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * DISPLAY VALUE
   * ============================================================
   * Contoh:
   * - Utuh
   * - Dibersihkan
   * - Fillet
   */

  label String

  /**
   * ============================================================
   * PRICE ADJUSTMENT
   * ============================================================
   * Tambahan harga berdasarkan varian.
   * Contoh:
   * Utuh         = 0
   * Dibersihkan  = 5000
   * Fillet       = 10000
   * Nilai ini akan ditambahkan ke harga dasar
   * atau harga berdasarkan pilihan berat.
   */

  priceAdjustment Decimal @default(0) @db.Decimal(12, 2)

  weightVariantPrices ProductWeightVariantPrice[] @relation("ProductWeightVariantPriceVariant")
  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  /**
   * Satu produk tidak boleh memiliki
   * varian dengan nama yang sama.
   */

  @@unique([productId, label])
  @@index([productId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("ProductVariantOption")
}

/**
 * ============================================================
 * PRODUCT WEIGHT VARIANT PRICE
 * ============================================================
 * Menyimpan harga khusus berdasarkan kombinasi:
 * Product
 * + Weight
 * + Variant
 * Contoh:
 * 1 KG + Utuh         = 100000
 * 1 KG + Dibersihkan  = 105000
 * 2 KG + Utuh         = 200000
 * 2 KG + Dibersihkan  = 207000
 * 3 KG + Utuh         = 300000
 * 3 KG + Dibersihkan  = 210000
 * Harga di sini adalah HARGA FINAL NORMAL
 * untuk kombinasi tersebut, bukan adjustment.
 * ============================================================
 */

/**
 * ============================================================
 * PRODUCT WEIGHT VARIANT PRICE
 * ============================================================
 * Harga khusus berdasarkan kombinasi:
 * Product
 * + Weight
 * + Variant
 * Contoh:
 * 1 KG + Utuh         = 100000
 * 1 KG + Dibersihkan  = 105000
 * 2 KG + Utuh         = 200000
 * 2 KG + Dibersihkan  = 207000
 * 3 KG + Utuh         = 300000
 * 3 KG + Dibersihkan  = 210000
 * price = harga normal FINAL untuk kombinasi.
 * Bukan price adjustment.
 * ============================================================
 */

model ProductWeightVariantPrice {
  id String @id @default(cuid())

  /**
   * PRODUCT
   */
  productId String

  product Product @relation("ProductWeightVariantPriceProduct", fields: [productId], references: [id])

  /**
   * WEIGHT
   */
  weightOptionId String

  weightOption ProductWeightOption @relation("ProductWeightVariantPriceWeight", fields: [weightOptionId], references: [id])

  /**
   * VARIANT
   */
  variantOptionId String

  variantOption LegacyProductVariantOption @relation("ProductWeightVariantPriceVariant", fields: [variantOptionId], references: [id])

  /**
   * PRICE
   */
  price Decimal @db.Decimal(15, 2)

  /**
   * TIMESTAMPS
   */
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * UNIQUE COMBINATION
   */
  @@unique([productId, weightOptionId, variantOptionId])
  /**
   * INDEXES
   */
  @@index([productId])
  @@index([weightOptionId])
  @@index([variantOptionId])
  @@index([productId, weightOptionId])
  @@index([productId, variantOptionId])
}

model StockLedger {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation("ProductStockLedgers", fields: [productId], references: [id], onDelete: Cascade)

