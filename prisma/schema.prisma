model ProductImage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  image String

  sortOrder   Int     @default(0)
  isThumbnail Boolean @default(false)

  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod PaymentMethod

  /**
   * ============================================================
   * PAYMENT CHANNEL
   * ============================================================
   * Metode/channel pembayaran spesifik yang dipilih customer.
   * Contoh:
   * - BCA
   * - BRI
   * - Mandiri
   * - BNI
   */
  paymentChannelId String?

  paymentChannel PaymentChannel? @relation(fields: [paymentChannelId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * VOUCHER SNAPSHOT
   * ============================================================
   * Informasi voucher yang digunakan saat order dibuat.
   * Snapshot disimpan agar perubahan konfigurasi voucher
   * di masa depan tidak mengubah riwayat order.
   */

  voucherId String?

  voucherCode String?

  voucherName String?

  voucherDiscount Decimal @default(0) @db.Decimal(12, 2)

  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  shippingCost Decimal @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  notes String?

  /**
   * ============================================================
   * PAYMENT TIMESTAMP
   * ============================================================
   */

  paidAt DateTime?

  /**
   * ============================================================
   * INTERNAL SHIPPING
   * ============================================================
   * Digunakan untuk sistem pengiriman Fish Market.
   * Saat ini:
   * - INTERNAL
   * Masa depan dapat mendukung:
   * - JNE
   * - J&T
   * - SiCepat
   * - AnterAja
   * - POS
   */

  shippingProvider String?

  shippingService String?

  trackingNumber String? @unique

  shippedAt DateTime?

  /**
   * ============================================================
   * LEGACY / COMPATIBILITY
   * ============================================================
   * Dipertahankan sementara agar tidak merusak kode lama
   * yang mungkin masih menggunakan shippingAt.
   */

  shippingAt DateTime?

  completedAt DateTime?

  items OrderItem[]

  notifications Notification[]

  paymentProof PaymentProof?

  deletedAt DateTime?

  stockLedgers StockLedger[] @relation("OrderStockLedgers")

  flashSalePurchases FlashSalePurchase[]

  /**
   * ============================================================
   * REWARD POINT TRANSACTIONS
   * ============================================================
   * Riwayat transaksi reward yang berasal dari order ini.
   * Contoh:
   * Order COMPLETED
   * ↓
   * RewardPointTransaction
   * ↓
   * EARN +15 poin
   */

  rewardPointTransactions RewardPointTransaction[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  voucherUsage VoucherUsage?

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([voucherId])
  @@index([voucherCode])
}

model OrderItem {
  id String @id @default(uuid())

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   */

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation(fields: [productId], references: [id])

  /// New canonical sellable SKU. Nullable during migration.
  skuId String?
  sku   ProductSku? @relation("OrderItemSku", fields: [skuId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * PRODUCT SNAPSHOT
   * ============================================================
   */

  productName String

  /**
   * ============================================================
   * PRODUCT OPTIONS
   * ============================================================
   */

  productVariant String?

  productWeight String?

  /**
   * ============================================================
   * WEIGHT SKU SNAPSHOT
   * ============================================================
   * SKU pilihan berat saat checkout.
   * Nilai ini disimpan permanen agar:
   * - Resi pesanan lama tetap konsisten
   * - Riwayat order tidak berubah
   * - Perubahan SKU produk di masa depan
   * tidak mempengaruhi pesanan lama
   */

  weightSku String?

  /**
   * ============================================================
   * CUSTOMER NOTE
   * ============================================================
   */

  customerNote String?

  /**
   * ============================================================
   * PRICE
   * ============================================================
   */

  price Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * SUBTOTAL
   * ============================================================
   */

  subtotal Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([orderId])
  @@index([productId])
  @@index([skuId])
}

/**
 * ============================================================
 * VOUCHER
 * ============================================================
 * Menyimpan konfigurasi voucher yang dapat digunakan
 * oleh customer saat checkout.
 */

model Voucher {
  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  code String @unique

  name String

  description String?

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * DISCOUNT
   * ============================================================
   */

  discountType VoucherDiscountType

  discountValue Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * PURCHASE REQUIREMENT
   * ============================================================
   * Minimum subtotal agar voucher dapat digunakan.
   */

  minimumPurchase Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * MAXIMUM DISCOUNT
   * ============================================================
   * Digunakan terutama untuk percentage voucher.
   * Contoh:
   * Diskon 20%
   * Maximum Discount Rp25.000
   */

  maximumDiscount Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * VALIDITY PERIOD
   * ============================================================
   */

  startAt DateTime?

  endAt DateTime?

  /**
   * ============================================================
   * USAGE LIMIT
   * ============================================================
   * usageLimit:
   * null = unlimited
   * usageCount:
   * jumlah voucher yang sudah digunakan.
   */

  usageLimit Int?

  usageCount Int @default(0)

  /**
   * ============================================================
   * PER USER LIMIT
   * ============================================================
   * null = unlimited
   */

  perUserLimit Int?

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  orders Order[]

  userVoucher UserVoucher?

  usages VoucherUsage[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([code])
  @@index([isActive])
  @@index([startAt])
  @@index([endAt])
  @@index([deletedAt])
}

// ============================================================
// REWARD VOUCHER SETTING
// ============================================================
//
// Konfigurasi reward yang dapat ditukar menggunakan point.
//
// Contoh:
//
// 500 Point
//     ↓
// Voucher Rp1.000
//
// 1.000 Point
//     ↓
// Voucher Rp2.500
//
// 2.000 Point
//     ↓
// Voucher 5%
//
// Setting ini dikelola dari Admin.
// ============================================================

model RewardVoucherSetting {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  /**
   * ============================================================
   * REQUIRED POINT
   * ============================================================
   * Jumlah point yang harus dimiliki customer
   * untuk menukarkan reward ini.
   * Contoh:
   * 500
   * 1000
   * 2000
   */

  requiredPoints Int

  /**
   * ============================================================
   * VOUCHER DISCOUNT
   * ============================================================
   * Menggunakan enum VoucherDiscountType yang sudah
   * digunakan oleh sistem Voucher.
   * PERCENTAGE
   * FIXED_AMOUNT
   */

  discountType VoucherDiscountType

  discountValue Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * MINIMUM PURCHASE
   * ============================================================
   * Optional.
   * Contoh:
   * Voucher Rp10.000
   * Minimum pembelian Rp50.000
   */

  minimumPurchase Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * MAXIMUM DISCOUNT
   * ============================================================
   * Relevan terutama untuk percentage voucher.
   * Contoh:
   * 5%
   * maximum discount Rp20.000
   */

  maximumDiscount Decimal? @db.Decimal(12, 2)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   * Menentukan urutan reward pada halaman customer.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATION
   * ============================================================
   */

  userVouchers UserVoucher[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([requiredPoints])
  @@index([isActive])
  @@index([sortOrder])
}

// ============================================================
// REWARD CATEGORY
// ============================================================
//
// Kategori hadiah fisik yang digunakan untuk mengelompokkan
// RewardCatalog.
//
// Contoh:
//
// Kebutuhan Rumah
// Dapur
// Elektronik
// Lifestyle
//
// Category adalah data master yang dikelola Admin.
// ============================================================

model RewardCategory {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  /**
   * ============================================================
   * SLUG
   * ============================================================
   * Digunakan untuk identifier yang stabil.
   * Contoh:
   * kebutuhan-rumah
   * dapur
   * elektronik
   */

  slug String @unique

  /**
   * ============================================================
   * STATUS
   * ============================================================
   * Category yang tidak aktif tidak ditampilkan sebagai
   * pilihan category baru.
   * Reward yang sudah menggunakan category tersebut
   * tetap mempertahankan relasinya.
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   * Menentukan urutan category.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATION
   * ============================================================
   */

  rewards RewardCatalog[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================================
// REWARD CATALOG
// ============================================================

// ============================================================
// REWARD CATALOG
// ============================================================
//
// Katalog hadiah fisik yang dapat ditukar menggunakan
// reward point.
//
// Contoh:
//
// TV Samsung 43"
//     25.000 Point
//
// Kulkas
//     30.000 Point
//
// Sepeda Gunung
//     15.000 Point
//
// Data ini dikelola oleh Admin.
// ============================================================

model RewardCatalog {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  description String?

  image String?

  /**
   * ============================================================
   * REWARD CATEGORY
   * ============================================================
   * Nullable sementara pada tahap migrasi agar RewardCatalog
   * existing tidak rusak.
   * Setelah category master dan assignment selesai,
   * field ini akan kita enforce menjadi required.
   */

  categoryId String?

  category RewardCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * REQUIRED POINT
   * ============================================================
   * Jumlah point yang diperlukan customer
   * untuk melakukan claim satu hadiah.
   */

  requiredPoints Int

  /**
   * ============================================================
   * STOCK
   * ============================================================
   * Jumlah hadiah yang masih tersedia.
   * Satu RewardClaim akan mengurangi stock sebesar 1.
   */

  stock Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * SORT ORDER
   * ============================================================
   * Menentukan urutan hadiah pada katalog customer.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATION
   * ============================================================
   */

  claims RewardClaim[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([categoryId])
  @@index([isActive])
  @@index([requiredPoints])
  @@index([sortOrder])
}

// ============================================================
// REWARD CLAIM
// ============================================================
//
// Mencatat customer yang menukarkan reward point
// dengan hadiah fisik.
//
// Satu RewardClaim = satu unit hadiah.
//
// Contoh:
//
// Customer
//     ↓
// Claim TV
//     ↓
// 25.000 point
//
// Point:
//     REDEEM -25.000
//
// Stock:
//     -1
// ============================================================

model RewardClaim {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * CUSTOMER
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rewardPointTransactions RewardPointTransaction[]

  /**
   * ============================================================
   * REWARD CATALOG
   * ============================================================
   */

  rewardCatalogId String

  rewardCatalog RewardCatalog @relation(fields: [rewardCatalogId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * POINT SNAPSHOT
   * ============================================================
   * Jumlah point yang benar-benar digunakan
   * ketika claim dibuat.
   * Tidak mengambil kembali dari RewardCatalog
   * karena konfigurasi hadiah dapat berubah
   * di masa depan.
   */

  pointsSpent Int

  /**
   * ============================================================
   * REWARD SNAPSHOT
   * ============================================================
   * Snapshot diperlukan agar histori claim
   * tidak berubah ketika Admin mengedit katalog.
   */

  rewardName String

  rewardDescription String?

  rewardImage String?

  /**
   * ============================================================
   * CLAIM STATUS
   * ============================================================
   */

  status RewardClaimStatus @default(PENDING)

  /**
   * ============================================================
   * REJECTION
   * ============================================================
   * Diisi ketika claim ditolak.
   */

  rejectionReason String?

  /**
   * ============================================================
   * REFUND
   * ============================================================
   * Diisi ketika point dikembalikan karena claim ditolak
   * atau dibatalkan sebelum fulfillment.
   * null = point belum dikembalikan
   * DateTime = point sudah dikembalikan
   */
  refundedAt DateTime?

  /**
   * ============================================================
   * STATUS TIMESTAMPS
   * ============================================================
   */

  approvedAt DateTime?

  shippedAt DateTime?

  completedAt DateTime?

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([rewardCatalogId])
  @@index([status])
  @@index([userId, createdAt])
}

// ============================================================
// USER VOUCHER
// ============================================================
//
// Voucher hasil penukaran reward point.
//
// Satu record UserVoucher berarti:
// customer tertentu telah menukarkan reward tertentu
// dan mendapatkan Voucher tertentu.
//
// Contoh:
//
// User
//   ↓
// UserVoucher
//   ├── RewardVoucherSetting
//   └── Voucher
// ============================================================

model UserVoucher {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * REWARD VOUCHER SETTING
   * ============================================================
   * Menyimpan reward yang digunakan ketika redeem.
   * Relation ini menjadi referensi konfigurasi reward.
   */

  rewardVoucherSettingId String

  rewardVoucherSetting RewardVoucherSetting @relation(fields: [rewardVoucherSettingId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * VOUCHER
   * ============================================================
   * Voucher aktual yang dibuat untuk customer.
   * Satu Voucher hanya boleh dimiliki oleh satu UserVoucher.
   */

  voucherId String @unique

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * POINTS SPENT
   * ============================================================
   * Snapshot jumlah point yang dipakai ketika redeem.
   * Jangan mengambil kembali dari RewardVoucherSetting
   * karena setting admin dapat berubah di masa depan.
   */

  pointsSpent Int

  /**
   * ============================================================
   * TIMESTAMP
   * ============================================================
   */

  redeemedAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([rewardVoucherSettingId])
  @@index([userId, redeemedAt])
}

/**
 * ============================================================
 * VOUCHER USAGE
 * ============================================================
 * Mencatat penggunaan voucher oleh customer.
 * Data ini digunakan untuk:
 * - perUserLimit
 * - audit penggunaan voucher
 * - riwayat voucher
 */

model VoucherUsage {
  id String @id @default(uuid())

  /**
   * ============================================================
   * VOUCHER
   * ============================================================
   */

  voucherId String

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  /**
   * ============================================================
   * USER
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * ORDER
   * ============================================================
   * Satu order hanya boleh memiliki
   * satu record penggunaan voucher.
   */

  orderId String @unique

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * VOUCHER SNAPSHOT
   * ============================================================
   * Menyimpan nominal diskon aktual yang digunakan.
   */

  discountAmount Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * TIMESTAMP
   * ============================================================
   */

  usedAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([voucherId])
  @@index([userId])
  @@index([voucherId, userId])
  @@index([usedAt])
}

model PaymentProof {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  image String?

  bankName String?

  accountName String?

  accountNumber String?

  status PaymentStatus @default(PENDING)

  verifiedAt DateTime?

  verifiedById String?

  rejectionReason String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Account {
  id String @id @default(cuid())

  userId String

  type String

  provider String

  providerAccountId String

  refresh_token String? @db.Text

  access_token String? @db.Text

  expires_at Int?

  token_type String?

  scope String?

  id_token String? @db.Text

  session_state String?

  oauth_token String?

  oauth_token_secret String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MobileSession {
  id String @id @default(cuid())

  userId String

  refreshTokenHash String @unique

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String

  token String @unique

  expires DateTime

  @@unique([identifier, token])
}

model PaymentChannel {
  /**
   * ============================================================
   * PRIMARY
   * ============================================================
   */

  id String @id @default(cuid())

  /**
   * ============================================================
   * IDENTITY
   * ============================================================
   */

  name String

  slug String @unique

  type PaymentChannelType @default(BANK_TRANSFER)

  /**
   * ============================================================
   * BANK INFORMATION
   * ============================================================
   */

  bankName String?

  accountNumber String?

  accountHolder String?

  /**
   * ============================================================
   * PAYMENT INSTRUCTION
   * ============================================================
   */

  instructions String?

  /**
   * ============================================================
   * QRIS IMAGE
   * ============================================================
   * Menyimpan URL/path gambar QRIS.
   * Digunakan hanya untuk payment channel
   * dengan type QRIS.
   * Contoh:
   * /uploads/payments/qris.png
   * atau URL storage.
   */

  qrisImage String?

  /**
   * ============================================================
   * DISPLAY
   * ============================================================
   */

  description String?

  icon String?

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   */

  orders Order[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([isActive])
  @@index([type])
  @@index([sortOrder])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// WISHLIST ITEM
// ============================================================

model WishlistItem {
  id String @id @default(uuid())

  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

// ============================================================
// STORE SETTINGS
// ============================================================

model StoreSettings {
  id String @id @default(uuid())

  // ----------------------------------------------------------
  // INFORMASI TOKO
  // ----------------------------------------------------------

  storeName        String  @default("Fish Market")
  storeDescription String?

  footerDescription String?

  /**
   * URL atau path logo situs.
   * null berarti sistem menggunakan fallback logo default.
   */
  siteLogo String?

  /**
   * ============================================================
   * HERO SLIDER IMAGES
   * ============================================================
   * Gambar visual untuk masing-masing slide Hero.
   * Jika null, homepage akan menggunakan icon default.
   * Mendukung:
   * - PNG
   * - WEBP
   * - GIF
   */

  heroSlide1Image String?

  heroSlide2Image String?

  heroSlide3Image String?

  email    String?
  whatsapp String?

  // ----------------------------------------------------------
  // ALAMAT TOKO
  // ----------------------------------------------------------

  address    String?
  city       String?
  province   String?
  postalCode String?

  // ==========================================================
  // STORE LOCATION / SHIPPING ORIGIN
  // ==========================================================

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // ==========================================================
  // INTERNAL SHIPPING CONFIGURATION
  // ==========================================================

  internalShippingEnabled Boolean @default(true)

  internalShippingName String @default("Kurir Internal")

  internalShippingBaseFee Decimal @default(0) @db.Decimal(12, 2)

  internalShippingPerKmFee Decimal @default(0) @db.Decimal(12, 2)

  internalShippingMaxDistance Decimal @default(10) @db.Decimal(10, 2)

  internalShippingFreeThreshold Decimal? @db.Decimal(14, 2)

  // ----------------------------------------------------------
  // OPERASIONAL
  // ----------------------------------------------------------

  openingTime String?
  closingTime String?

  // ----------------------------------------------------------
  // ORDER SETTINGS
  // ----------------------------------------------------------

  paymentTimeoutHours Int @default(24)

  // ----------------------------------------------------------
  // TIMESTAMP
  // ----------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType
  href    String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([orderId])
}

model PushSubscription {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @db.Text

  p256dh String @db.Text

  auth String @db.Text

  userAgent String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
}

model Promotion {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  banner String?

  status PromotionStatus @default(DRAFT)

  startAt DateTime?
  endAt   DateTime?

  type PromotionType @default(MARKETING)

  discountType  PromotionDiscountType?
  discountValue Decimal?               @db.Decimal(12, 2)

  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)

  items PromotionItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([status, startAt, endAt])
}

model PromotionItem {
  id String @id @default(uuid())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([promotionId, skuId])
  @@index([promotionId])
  @@index([skuId])
}
