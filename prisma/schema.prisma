model ProductImage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// URL media. Untuk IMAGE berisi URL gambar, untuk VIDEO berisi URL video.
  image String

  /// Backward-compatible media discriminator. Existing rows tetap IMAGE.
  mediaType ProductMediaType @default(IMAGE)

  sortOrder   Int     @default(0)
  isThumbnail Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, mediaType])
  @@index([productId, sortOrder])
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod PaymentMethod

  /**
   * ============================================================
   * PAYMENT CHANNEL
   * ============================================================
   * Metode/channel pembayaran spesifik yang dipilih customer.
   * Contoh:
   * - BCA
   * - BRI
   * - Mandiri
   * - BNI
   */
  paymentChannelId String?

  paymentChannel PaymentChannel? @relation(fields: [paymentChannelId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(12, 2)

  /**
   * ============================================================
   * VOUCHER SNAPSHOT
   * ============================================================
   * Informasi voucher yang digunakan saat order dibuat.
   * Snapshot disimpan agar perubahan konfigurasi voucher
   * di masa depan tidak mengubah riwayat order.
   */

  voucherId String?

  voucherCode String?

  voucherName String?

  voucherDiscount Decimal @default(0) @db.Decimal(12, 2)

  voucherShippingDiscount Decimal @default(0) @db.Decimal(12, 2)

  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  shippingCost Decimal @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  notes String?

  /**
   * ============================================================
   * PAYMENT TIMESTAMP
   * ============================================================
   */

  paidAt DateTime?

  /**
   * ============================================================
   * INTERNAL SHIPPING
   * ============================================================
   * Digunakan untuk sistem pengiriman Fish Market.
   * Saat ini:
   * - INTERNAL
   * Masa depan dapat mendukung:
   * - JNE
   * - J&T
   * - SiCepat
   * - AnterAja
   * - POS
   */

  shippingProvider String?

  shippingService String?

  trackingNumber String? @unique

  shippedAt DateTime?

  /**
   * ============================================================
   * LEGACY / COMPATIBILITY
   * ============================================================
   * Dipertahankan sementara agar tidak merusak kode lama
   * yang mungkin masih menggunakan shippingAt.
   */

  shippingAt DateTime?

  completedAt DateTime?

  items OrderItem[]

  notifications Notification[]

  paymentProof PaymentProof?

  deletedAt DateTime?

  stockLedgers StockLedger[] @relation("OrderStockLedgers")

  flashSalePurchases FlashSalePurchase[]

  /**
   * ============================================================
   * REWARD POINT TRANSACTIONS
   * ============================================================
   * Riwayat transaksi reward yang berasal dari order ini.
   * Contoh:
   * Order COMPLETED
   * ↓
   * RewardPointTransaction
   * ↓
   * EARN +15 poin
   */

  rewardPointTransactions RewardPointTransaction[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  voucherUsage VoucherUsage?

  wapiDeliveries WapiDelivery[] @relation("OrderWapiDeliveries")
  wapiCustomerDeliveries WapiCustomerDelivery[] @relation("OrderWapiCustomerDeliveries")

  courierAssignments CourierAssignment[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([voucherId])
  @@index([voucherCode])
}

model OrderItem {
  id String @id @default(uuid())

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   */

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation(fields: [productId], references: [id])

  /// New canonical sellable SKU. Nullable during migration.
  skuId String?
  sku   ProductSku? @relation("OrderItemSku", fields: [skuId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * PRODUCT SNAPSHOT
   * ============================================================
   */

  productName String

  /**
   * ============================================================
   * PRODUCT OPTIONS
   * ============================================================
   */

  productVariant String?

  productWeight String?

  /**
   * ============================================================
   * WEIGHT SKU SNAPSHOT
   * ============================================================
   * SKU pilihan berat saat checkout.
   * Nilai ini disimpan permanen agar:
   * - Resi pesanan lama tetap konsisten
   * - Riwayat order tidak berubah
   * - Perubahan SKU produk di masa depan
   * tidak mempengaruhi pesanan lama
   */

  weightSku String?

  /// Berat produk dalam gram sebagai snapshot saat checkout.
  /// Digunakan terutama untuk simple product yang tidak memiliki
  /// pilihan berat pada SKU.
  weightGrams Int?

  /**
   * ============================================================
   * CUSTOMER NOTE
   * ============================================================
   */

  customerNote String?

  /**
   * ============================================================
   * PRICE
   * ============================================================
   */

  price Decimal @db.Decimal(12, 2)

  /// Snapshot status Pre-Order saat order dibuat.
  isPreOrder Boolean @default(false)

  /// Snapshot estimasi minimum Pre-Order saat order dibuat.
  preOrderMinDays Int?

  /// Snapshot estimasi maksimum Pre-Order saat order dibuat.
  preOrderMaxDays Int?

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * SUBTOTAL
   * ============================================================
   */

