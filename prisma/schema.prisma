}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum WapiDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  passwordChangedAt DateTime?

  phone         String?   @unique

  // ============================================================
  // WHATSAPP CUSTOMER NOTIFICATION PREFERENCES
  // ============================================================
  // Transactional messages are enabled by default for customers
  // with a WhatsApp number. Marketing remains opt-in separately.
  wapiTransactionalEnabled Boolean  @default(true)
  wapiMarketingOptIn      Boolean  @default(false)
  wapiMarketingOptInAt    DateTime?
  wapiMarketingOptOutAt   DateTime?

  avatar        String?
  emailVerified DateTime?

  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)

  addresses Address[]
  orders    Order[]
  cart      Cart?

  voucherUsages VoucherUsage[]

  flashSalePurchases FlashSalePurchase[]

  notifications Notification[]

  pushSubscriptions PushSubscription[]

  accounts Account[]
  sessions Session[]

  mobileSessions MobileSession[]

  passwordResetTokens PasswordResetToken[]

  emailVerificationOtps EmailVerificationOtp[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  wishlist Wishlist?

  /**
   * ============================================================
   * REWARD POINTS
   * ============================================================
   * Saldo poin reward customer saat ini.
   * Nilai ini merupakan cached balance.
   * Seluruh perubahan tetap dicatat di
   * RewardPointTransaction sebagai ledger.
   */

  rewardPointsBalance Int @default(0)

  rewardPointTransactions RewardPointTransaction[]

  userVouchers UserVoucher[]

  rewardClaims RewardClaim[]

  /**
   * Current derived membership tier for customer benefits.
   */
  memberTierId String?
  memberTier   MemberTier? @relation(fields: [memberTierId], references: [id], onDelete: SetNull)

  productReviews ProductReview[]

  wapiDeliveries WapiDelivery[] @relation("UserWapiDeliveries")
  wapiCustomerDeliveries WapiCustomerDelivery[] @relation("UserWapiCustomerDeliveries")
  wapiCustomerAuditLogs WapiCustomerAuditLog[] @relation("WapiCustomerAuditActors")

  courierAssignments CourierAssignment[] @relation("CourierAssignments")

  courierAssignedBy CourierAssignment[] @relation("CourierAssignmentsAssignedBy")

  courierAssignmentEvents CourierAssignmentEvent[] @relation("CourierAssignmentEventActor")

  courierDeliveryProofs CourierDeliveryProof[] @relation("CourierDeliveryProofCreatedBy")
  courierSlaSettings CourierSlaSettings[]

  @@index([email])
  @@index([role])
}

// ============================================================
// PISJO MEMBER TIER
// ============================================================
//
// Membership tier customer berdasarkan total transaksi
// terverifikasi dalam rolling 12 bulan.
//
// Point tetap menjadi loyalty currency terpisah.
// Tier menentukan benefit membership.
// ============================================================

model MemberTier {
  id String @id @default(uuid())

  name String

  slug String @unique

  /**
   * Minimum verified spending dalam rolling membership period.
   */
  minSpend Decimal @db.Decimal(12, 2)

  /**
   * Bonus point percentage untuk transaksi berikutnya.
   * 25 berarti +25% dari point dasar.
   */
  bonusPointsPercent Int @default(0)

  freeShipping Boolean @default(false)

  prioritySupport Boolean @default(false)

  exclusivePricing Boolean @default(false)

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  users User[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([minSpend])
  @@index([isActive])
  @@index([sortOrder])
}

// ============================================================
// REWARD POINT TRANSACTION
// ============================================================

model RewardPointTransaction {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * ORDER RELATION
   * ============================================================
   * Diisi ketika transaksi reward berasal dari order.
   * Contoh:
   * COMPLETED
   * ↓
   * EARN
   * ↓
   * orderId = order tersebut
   * Untuk transaksi manual seperti ADJUSTMENT,
   * orderId dapat bernilai null.
   */

  orderId String?

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /**
   * ============================================================
   * REWARD CLAIM RELATION
   * ============================================================
   * Digunakan untuk menghubungkan transaksi point
   * dengan claim reward fisik.
   * Satu RewardClaim dapat memiliki:
   * REDEEM  -N
   * REFUND  +N
   * sehingga rewardClaimId TIDAK boleh unique.
   */

  rewardClaimId String?

  rewardClaim RewardClaim? @relation(fields: [rewardClaimId], references: [id], onDelete: SetNull)

  /**
   * ============================================================
   * TRANSACTION TYPE
   * ============================================================
   */

  type RewardPointTransactionType

  /**
   * ============================================================
   * POINTS
   * ============================================================
   * Nilai transaksi.
   * EARN:
   * +15
   * REDEEM:
   * -25
   * ADJUSTMENT:
   * dapat positif atau negatif
   * EXPIRED:
   * -10
   */

  points Int

  /**
   * ============================================================
   * WEIGHT SNAPSHOT
   * ============================================================
   * Total berat yang digunakan ketika poin EARN dihitung.
   * Disimpan sebagai gram agar tidak bergantung pada
   * format string seperti "1 KG", "500 GR", dan sebagainya.
   * Null untuk transaksi yang tidak berasal dari pembelian.
   */

  weightGrams Int?

  /**
   * ============================================================
   * DESCRIPTION
   * ============================================================
   */

  description String?

  /**
   * ============================================================
   * IDEMPOTENCY REFERENCE
   * ============================================================
   *
   * Digunakan untuk transaksi reward non-order seperti bonus
   * pendaftaran. Nilai unik memastikan bonus yang sama tidak
   * pernah diberikan dua kali walaupun terjadi retry/concurrent request.
   */

  referenceKey String? @unique

  /**
   * ============================================================
   * TIMESTAMP
   * ============================================================
   */

  rewardViewedAt DateTime?

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@unique([orderId, type])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
  @@index([rewardClaimId])
}

// ============================================================
// REWARD POINT SETTINGS
// ============================================================

model RewardPointSettings {
  id String @id @default(uuid())

  /**
   * Singleton key.
   * Hanya boleh ada satu konfigurasi reward point aktif.
   */
  key String @unique @default("default")

  /**
   * Jumlah point untuk setiap 1 KG pembelian.
   * Contoh:
   * 10 = 1 KG -> 10 point
   * 15 = 1 KG -> 15 point
   */
  pointsPerKg Int @default(10)

  /**
   * Bonus point yang diberikan satu kali setelah customer
   * berhasil menyelesaikan registrasi/verifikasi akun.
   * Nilai 0 berarti bonus pendaftaran dinonaktifkan.
   */
  signupBonusPoints Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PASSWORD RESET TOKEN
// ============================================================

model PasswordResetToken {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * TOKEN SECURITY
   * ============================================================
   * Raw token TIDAK disimpan di database.
   * Yang disimpan hanya hash dari token.
   */

  tokenHash String @unique

  /**
   * ============================================================
   * EXPIRATION
   * ============================================================
   */

  expiresAt DateTime

  /**
   * ============================================================
   * SINGLE USE
   * ============================================================
   * null = belum digunakan
   * DateTime = sudah digunakan
   */

  usedAt DateTime?

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

// ============================================================
// EMAIL VERIFICATION OTP
// ============================================================

model EmailVerificationOtp {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * USER RELATION
   * ============================================================
   */

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * OTP SECURITY
   * ============================================================
   * OTP tidak disimpan dalam bentuk raw/plain text.
   * Yang disimpan hanya hash OTP.
   */

  codeHash String

  /**
   * ============================================================
   * EXPIRATION
   * ============================================================
   */

  expiresAt DateTime

  /**
   * ============================================================
   * SINGLE USE
   * ============================================================
   * null     = belum digunakan
   * DateTime = sudah berhasil digunakan
   */

  usedAt DateTime?

  /**
   * ============================================================
   * SECURITY
   * ============================================================
   * Jumlah percobaan memasukkan OTP.
   */

  attempts Int @default(0)

  /**
   * ============================================================
   * RESEND CONTROL
   * ============================================================
   * Digunakan untuk membatasi pengiriman OTP berulang.
   */

  createdAt DateTime @default(now())

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Cart {
  id String @id @default(uuid())

  userId      String? @unique
  guestCartId String? @unique

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestCartId])
}

model CartItem {
  id String @id @default(uuid())

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id])

  /**
   * ============================================================
   * PRODUCT OPTIONS
   * ============================================================
   */

  productVariant String?

  productWeight String?

  /**
   * ============================================================
   * WEIGHT SKU SNAPSHOT
   * ============================================================
   * SKU dari pilihan berat yang dipilih customer.
   * Disimpan sebagai snapshot agar cart tetap mengetahui
   * SKU pilihan yang sedang dibeli.
   */

  weightSku String?

  /// New canonical sellable SKU. Nullable during migration.
  skuId String?
  sku   ProductSku? @relation("CartItemSku", fields: [skuId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * CUSTOMER NOTE
   * ============================================================
   */

  customerNote String?

  /**
   * ============================================================
   * QUANTITY
   * ============================================================
   */

  quantity Int

  /**
   * ============================================================
   * PRICE
   * ============================================================
   * Snapshot harga satuan ketika item dimasukkan
   * ke dalam keranjang.
   */

  price Decimal @db.Decimal(12, 2)

  /// Snapshot status Pre-Order ketika item masuk ke cart.
  isPreOrder Boolean @default(false)

  /// Snapshot estimasi minimum Pre-Order.
  preOrderMinDays Int?

  /// Snapshot estimasi maksimum Pre-Order.
  preOrderMaxDays Int?

  /**
   * ============================================================
   * FLASH SALE SNAPSHOT
   * ============================================================
   * Cart tidak boleh menjadi sumber kebenaran final
   * untuk Flash Sale.
   * Field ini hanya menyimpan snapshot bahwa item
   * masuk ke cart menggunakan Flash Sale tertentu.
   * Saat checkout, Flash Sale wajib divalidasi ulang.
   */

  isFlashSaleApplied Boolean @default(false)

  flashSaleId String?

  flashSaleItemId String?

  /**
   * ============================================================
   * FLASH SALE RELATIONS
   * ============================================================
   */

  flashSale FlashSale? @relation("CartItemFlashSale", fields: [flashSaleId], references: [id], onDelete: SetNull)

  flashSaleItem FlashSaleItem? @relation("CartItemFlashSaleItem", fields: [flashSaleItemId], references: [id], onDelete: SetNull)

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  /**
   * ============================================================
   * UNIQUE CART ITEM
   * ============================================================
   */

  @@unique([cartId, productId, skuId])
  @@index([cartId])
  @@index([productId])
  @@index([skuId])
  @@index([flashSaleId])
  @@index([flashSaleItemId])
}

model Address {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[] // <-- WAJIB ADA

  receiverName  String
  receiverPhone String

  provinceCode String?
  cityCode     String?
  districtCode String?
  villageCode  String?

  province String
  city     String
  district String
  village  String

  postalCode  String
  fullAddress String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  label String?
  notes String?

  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([provinceCode])
  @@index([cityCode])
  @@index([districtCode])
  @@index([villageCode])
}

model Category {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

  image String?

  description String?

  /**
   * ============================================================
   * DISPLAY ORDER
   * ============================================================
   * Digunakan untuk menentukan urutan kategori.
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * STATUS
   * ============================================================
   * true  = kategori aktif
   * false = kategori nonaktif
   */

  isActive Boolean @default(true)

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  products Product[]

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * SOFT DELETE
   * ============================================================
   */

  deletedAt DateTime?

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

model Product {
  id String @id @default(uuid())

  /**
   * ============================================================
   * CATEGORY RELATION
   * ============================================================
   */

  categoryId String

  category Category @relation(fields: [categoryId], references: [id])

  /**
   * ============================================================
   * PRODUCT INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

  description String?

  /// Bahan/kandungan produk.
  ingredients String?

  /// Informasi nutrisi terstruktur.
  nutritionInformation Json?

  /// Cara menyimpan produk.
  storageInstructions String?

  /// Cara menggunakan/mengolah produk.
  usageInstructions String?

  /// Kondisi produk untuk transparansi kualitas seafood di storefront.
  condition ProductCondition @default(FRESH)

  sku String? @unique

  /// LEGACY PRODUCT-LEVEL PRICE. SKU.price is canonical for variant products.
  price Decimal @db.Decimal(12, 2)

  // Produk dapat dipesan sebelum stok fisik tersedia.
  isPreOrder Boolean @default(false)

  /// Estimasi minimum persiapan Pre-Order dalam hari.
  preOrderMinDays Int?

  /// Estimasi maksimum persiapan Pre-Order dalam hari.
  preOrderMaxDays Int?

  /**
   * ============================================================
   * PRODUCT DISCOUNT
   * ============================================================
   * Diskon diterapkan oleh ProductPricingService.
   * Contoh:
   * PERCENTAGE + 10
   * = diskon 10%
   * FIXED_AMOUNT + 5000
   * = diskon Rp5.000
   */

  isDiscountActive Boolean @default(false)

  discountType ProductDiscountType?

  discountValue Decimal? @db.Decimal(12, 2)

  discountStartAt DateTime?

  discountEndAt DateTime?

  /// LEGACY PRODUCT-LEVEL STOCK. SKU.stock becomes source-of-truth.
  stock Int @default(0)

  /// Berat default produk simple dalam gram.
  /// Digunakan ketika produk tidak memiliki variant group.
  weightGrams Int?

  isPublished Boolean @default(true)

  featured Boolean @default(false)

  images ProductImage[]

  legacyVariantOptions LegacyProductVariantOption[] @relation("LegacyProductVariantOptions")

  variantGroups ProductVariantGroup[]

  skus ProductSku[]

  weightOptions ProductWeightOption[] @relation("ProductWeightOptions")

  weightVariantPrices ProductWeightVariantPrice[] @relation("ProductWeightVariantPriceProduct")

  flashSaleItems FlashSaleItem[]

  stockLedgers StockLedger[] @relation("ProductStockLedgers")

  orderItems OrderItem[]

  cartItems CartItem[]

  wishlistItems WishlistItem[]

  productReviews ProductReview[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([categoryId])
  @@index([slug])
  @@index([isDiscountActive])
  @@index([discountStartAt])
  @@index([discountEndAt])
}

/**
 * ============================================================
 * PRODUCT REVIEW
 * ============================================================
 * Guest review diperbolehkan. userId nullable agar review dapat
 * dikaitkan ke customer login di masa depan tanpa migrasi ulang.
 * Semua review guest masuk PENDING terlebih dahulu.
 */
model ProductReview {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  username String
  email    String?
  rating   Int
  review   String?

  status ProductReviewStatus @default(PENDING)

  isVerifiedPurchase Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([productId, rating])
  @@index([email])
  @@index([createdAt])
}

/**
 * ============================================================
 * PRODUCT WEIGHT OPTION
 * ============================================================
 * Menyimpan pilihan berat yang tersedia
 * untuk setiap produk.
 * Contoh:
 * Produk Ikan Tuna:
 * - 250gr
 * - 500gr
 * - 1kg
 * Produk Udang:
 * - 500gr
 * - 1kg
 * - 2kg
 */
model ProductWeightOption {
  id String @id @default(uuid())

  productId String

  product Product @relation("ProductWeightOptions", fields: [productId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * WEIGHT LABEL
   * ============================================================
   * Contoh:
   * - 250gr
   * - 500gr
   * - 1kg
   */

  label String

  /**
   * ============================================================
   * SKU
   * ============================================================
   * SKU khusus untuk pilihan berat produk.
   * Contoh:
   * 250gr -> CMA-250
   * 500gr -> CMA-500
   * 1kg   -> CMA-1000
   * Nullable sementara agar migration aman untuk
   * data pilihan berat yang sudah ada.
   */

  sku String?

  /**
   * ============================================================
   * PRICE
   * ============================================================
   */

  weightVariantPrices ProductWeightVariantPrice[] @relation("ProductWeightVariantPriceWeight")

  price Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  flashSaleItems FlashSaleItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([productId, label])
  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([sortOrder])
}

/**
 * ============================================================
 * FLASH SALE
 * ============================================================
 * Campaign utama Flash Sale.
 * Contoh:
 * Flash Sale Akhir Pekan
 * startAt:
 * 2026-08-22 00:00
 * endAt:
 * 2026-08-24 23:59
 */
model FlashSale {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * BASIC INFORMATION
   * ============================================================
   */

  name String

  slug String @unique

