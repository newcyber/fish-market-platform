/**
 * ============================================================
 * FLASH SALE ITEM
 * ============================================================
 * Produk atau pilihan berat produk yang mengikuti Flash Sale.
 */
model FlashSaleItem {
  /**
   * ============================================================
   * PRIMARY KEY
   * ============================================================
   */

  id String @id @default(uuid())

  /**
   * ============================================================
   * FLASH SALE RELATION
   * ============================================================
   */

  flashSaleId String

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)

  /**
   * ============================================================
   * PRODUCT RELATION
   * ============================================================
   */

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// New canonical sellable SKU. Nullable during migration.
  skuId String?
  sku   ProductSku? @relation("FlashSaleItemSku", fields: [skuId], references: [id], onDelete: Restrict)

  /**
   * ============================================================
   * WEIGHT OPTION
   * ============================================================
