  /**
   * ============================================================
   * DISPLAY
   * ============================================================
   */

  sortOrder Int @default(0)

  /**
   * ============================================================
   * RELATIONS
   * ============================================================
   */

  purchases FlashSalePurchase[]

  cartItems CartItem[] @relation("CartItemFlashSaleItem")

  /**
   * ============================================================
   * TIMESTAMPS
   * ============================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * ============================================================
   * INDEXES
   * ============================================================
   */

  @@index([flashSaleId])
  @@index([productId])
  @@index([skuId])
  @@index([weightOptionId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([flashSaleId, isActive])
